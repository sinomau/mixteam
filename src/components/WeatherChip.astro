---
// Weather chip for the header. Data comes from the /api/weather proxy.
// Legacy reference: legacy/js/weather.js
---

<span class="weather-chip" id="weather-chip" role="status"></span>

<script>
  const chip = document.querySelector<HTMLSpanElement>("#weather-chip")!;

  function esc(value: unknown): string {
    return String(value ?? "").replace(/[&<>"']/g, (ch) =>
      ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      })[ch]!
    );
  }

  // Lucide-style marks, matched to the OpenWeather icon code family.
  const ICONS: Record<string, string> = {
    "01": '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>',
    "02": '<path d="M12 2v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="M20 12h2"/><path d="m19.07 4.93-1.41 1.41"/><path d="M15.95 12.65a4 4 0 0 0-5.93-4.13"/><path d="M13 22H7a5 5 0 1 1 4.9-6H13a3 3 0 0 1 0 6Z"/>',
    "03": '<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>',
    "04": '<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>',
    "09": '<path d="M4 14.9A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.24"/><path d="M16 14v6"/><path d="M8 14v6"/><path d="M12 16v6"/>',
    "10": '<path d="M4 14.9A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.24"/><path d="M16 14v6"/><path d="M8 14v6"/><path d="M12 16v6"/>',
    "11": '<path d="M6 16.33A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 .5 8.97"/><path d="m13 12-3 5h4l-3 5"/>',
    "13": '<path d="M4 14.9A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.24"/><path d="M8 15h.01"/><path d="M8 19h.01"/><path d="M12 17h.01"/><path d="M12 21h.01"/><path d="M16 15h.01"/><path d="M16 19h.01"/>',
    "50": '<path d="M4 14.9A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.24"/><path d="M16 17H7"/><path d="M17 21H9"/>',
  };

  function iconMarkup(code: unknown): string {
    const key = String(code ?? "").slice(0, 2);
    const paths = ICONS[key];
    if (!paths) return "";
    return `<svg class="weather-chip__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
  }

  async function load() {
    try {
      const res = await fetch("/api/weather");
      if (!res.ok) return;
      const data = await res.json();

      chip.innerHTML = `
        ${iconMarkup(data.icon)}
        <span aria-label="Clima actual"><strong>${esc(data.temp)}°</strong> · ${esc(data.city)}</span>
      `;
    } catch {
      // Dejar el chip en blanco: el clima es secundario, no vale un mensaje.
    }
  }

  load();
</script>

<style>
  .weather-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-nav);
    color: var(--color-text-soft);
    border: 1px solid #2c4a3c;
    border-radius: 999px;
    padding: 0.55rem 0.95rem;
    font-size: var(--text-xs);
    min-height: 2.25rem;
  }

  .weather-chip :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .weather-chip :global(.weather-chip__icon) {
    width: 16px;
    height: 16px;
    color: var(--color-accent);
    flex-shrink: 0;
  }
</style>
