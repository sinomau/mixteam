---
import WeatherChip from "./WeatherChip.astro";

const links = [
  { href: "/", label: "Inicio" },
  { href: "/football/", label: "Liga Profesional" },
  { href: "/libertadores/", label: "Copa Libertadores" },
  { href: "/sudamericana/", label: "Copa Sudamericana" },
  { href: "/news/", label: "Noticias" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="brand" href="/" aria-label="MiXteam — Inicio">
      <img src="/assets/img/MiXteamW.png" alt="Logo de MiXteam" width="120" height="56" />
    </a>
    <nav class="site-nav" aria-label="Navegación principal">
      <ul>
        {
          links.map((link) => {
            const linkPath = link.href.replace(/\/$/, "") || "/";
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={path === linkPath ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <WeatherChip />
  </div>
</header>

<script>
  // On mobile the nav is a scroll strip with no visible scrollbar. Two
  // things have to be true for it to work: the user has to know that there
  // is more to the side, and the section they are on has to be visible
  // without scrolling first.
  const nav = document.querySelector<HTMLElement>(".site-nav")!;
  const list = nav.querySelector<HTMLUListElement>("ul")!;

  function updateEdges(): void {
    const max = list.scrollWidth - list.clientWidth;
    nav.classList.toggle("has-overflow-start", max > 1 && list.scrollLeft > 1);
    nav.classList.toggle("has-overflow-end", max > 1 && list.scrollLeft < max - 1);
  }

  function centerCurrent(): void {
    const current = list.querySelector<HTMLAnchorElement>('[aria-current="page"]');
    if (!current) return;

    const navBox = nav.getBoundingClientRect();
    const linkBox = current.getBoundingClientRect();
    const delta = linkBox.left - navBox.left - (list.clientWidth - linkBox.width) / 2;
    if (Math.abs(delta) < 1) return;

    list.scrollLeft += delta;
    updateEdges();
  }

  centerCurrent();
  updateEdges();

  list.addEventListener("scroll", updateEdges, { passive: true });
  window.addEventListener("resize", updateEdges);
</script>
