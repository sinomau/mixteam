---
import WeatherChip from "./WeatherChip.astro";

const links = [
  { href: "/", label: "Inicio" },
  { href: "/football/", label: "Liga Profesional" },
  { href: "/libertadores/", label: "Copa Libertadores" },
  { href: "/sudamericana/", label: "Copa Sudamericana" },
  { href: "/news/", label: "Noticias" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="brand" href="/" aria-label="MiXteam — Inicio">
      <img src="/assets/img/MiXteamW.png" alt="Logo de MiXteam" width="120" height="56" />
    </a>
    <nav class="site-nav" aria-label="Navegación principal">
      <ul>
        {
          links.map((link) => {
            const linkPath = link.href.replace(/\/$/, "") || "/";
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={path === linkPath ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <WeatherChip />
  </div>
</header>
