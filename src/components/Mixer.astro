---
// Team mixer island: the star feature of the site.
// The output is a football-pitch board: both squads stand on their own half.
// Product rule: teams must be even and 5, 6, 7, 8, 9 or 11 players per side.
// Legacy reference: legacy/js/index.js
---

<section class="mixer" aria-labelledby="mixer-title">
  <div class="mixer__hero">
    <h1 id="mixer-title">Crea tus equipos</h1>
    <p class="mixer__lead">Pegá la lista y se mezclan solos.</p>

    <ol class="mixer__steps" aria-label="Cómo funciona">
      <li><strong>1.</strong> Pegá la lista del grupo.</li>
      <li><strong>2.</strong> Se mezclan parejos solos.</li>
      <li><strong>3.</strong> Compartí por WhatsApp o copiá.</li>
    </ol>

    <ul class="mixer__formats" aria-label="Formatos soportados">
      <li>5v5</li>
      <li>6v6</li>
      <li>7v7</li>
      <li>8v8</li>
      <li>9v9</li>
      <li>11v11</li>
    </ul>

    <div class="mixer__form">
      <label class="mixer__form-label" for="paste-input">
        Pegá la lista del grupo o escribí los nombres
      </label>
      <textarea
        class="field mixer__form-input"
        id="paste-input"
        rows="5"
        placeholder={"1. Mauro\n2. José\n3. Santi"}
        spellcheck="false"
      ></textarea>
      <p class="mixer__form-hint" id="paste-hint" aria-live="polite">
        Escribí un nombre y apretá Enter, o pegá la lista completa.
      </p>
    </div>

    <div class="mixer__meta">
      <p class="mixer__rule" id="mixer-rule" aria-live="polite" data-state="idle">
        <svg
          class="mixer__rule-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        <span id="mixer-rule-text">Mínimo 10 jugadores: dos equipos de 5 y 5.</span>
      </p>
    </div>
  </div>

  <section class="mixer__output" id="mixer-output" aria-label="Equipos">
    <div class="mixer__pitch" id="pitch">
      <div class="mixer__pitch-lines" aria-hidden="true">
        <svg viewBox="0 0 1088 440" preserveAspectRatio="none">
          <rect x="16" y="16" width="1056" height="408" rx="10"></rect>
          <line x1="544" y1="16" x2="544" y2="424"></line>
          <circle cx="544" cy="220" r="72"></circle>
          <circle cx="544" cy="220" r="4" class="mixer__spot"></circle>
          <rect x="16" y="120" width="112" height="200"></rect>
          <rect x="960" y="120" width="112" height="200"></rect>
          <rect x="16" y="168" width="46" height="104"></rect>
          <rect x="1026" y="168" width="46" height="104"></rect>
        </svg>
      </div>
      <span class="mixer__half-label mixer__half-label--one">Equipo 1</span>
      <span class="mixer__half-label mixer__half-label--two">Equipo 2</span>
      <span class="mixer__pitch-count" id="teams-count" hidden></span>
      <div class="mixer__tokens" id="tokens" role="list" aria-label="Formación de los equipos"></div>
      <p class="mixer__pitch-empty" id="pitch-empty">
        Agregá jugadores y la cancha se arma sola
      </p>
      <span class="mixer__pitch-badge" id="pitch-badge" hidden>Provisorio</span>
    </div>
  </section>

  <div class="mixer__actions" id="mixer-actions" hidden>
    <button class="btn btn--whatsapp" type="button" id="share-button" hidden>
      Compartir en WhatsApp
    </button>
    <div class="mixer__actions-row">
      <button class="btn btn--soft" type="button" id="copy-button" hidden>
        Copiar equipos
      </button>
      <button class="btn btn--soft" type="button" id="download-button" hidden>
        Descargar imagen
      </button>
    </div>
    <div class="mixer__actions-row">
      <button class="btn btn--ghost" type="button" id="reshuffle-button" hidden>
        Mezclar de nuevo
      </button>
      <button class="btn btn--ghost" type="button" id="reset-button" hidden>
        Reiniciar
      </button>
    </div>
  </div>
</section>

<script>
  const STORAGE_KEYS = {
    list: "mixteam:list",
    players: "mixteam:players",
    teams: "mixteam:teams",
  } as const;

  /** Team sizes allowed by the product: even sides only. */
  const TEAM_SIZES: readonly number[] = [5, 6, 7, 8, 9, 11];
  const VALID_TOTALS = TEAM_SIZES.map((size) => size * 2);
  const MAX_PLAYERS = Math.max(...VALID_TOTALS);

  /** Outfield lines per team size; the keeper is always implicit. */
  const FORMATIONS: Record<number, readonly number[]> = {
    5: [2, 2],
    6: [2, 2, 1],
    7: [3, 2, 1],
    8: [3, 3, 1],
    9: [3, 3, 2],
    11: [4, 4, 2],
  };

  /** Horizontal fractions inside one half, from own goal to halfway line. */
  const LINE_X: Record<number, readonly number[]> = {
    2: [0.21, 0.35],
    3: [0.16, 0.255, 0.35],
    4: [0.145, 0.225, 0.305, 0.385],
  };

  const KEEPER_X = 0.065;
  const Y_MIN = 0.08;
  const Y_MAX = 0.92;

  const ruleEl = document.querySelector<HTMLParagraphElement>("#mixer-rule")!;
  const ruleText = document.querySelector<HTMLSpanElement>("#mixer-rule-text")!;
  const teamsCount = document.querySelector<HTMLSpanElement>("#teams-count")!;
  const tokensEl = document.querySelector<HTMLDivElement>("#tokens")!;
  const pitchEmpty = document.querySelector<HTMLParagraphElement>("#pitch-empty")!;
  const pitchBadge = document.querySelector<HTMLSpanElement>("#pitch-badge")!;
  const shareButton = document.querySelector<HTMLButtonElement>("#share-button")!;
  const copyButton = document.querySelector<HTMLButtonElement>("#copy-button")!;
  const downloadButton = document.querySelector<HTMLButtonElement>("#download-button")!;
  const reshuffleButton = document.querySelector<HTMLButtonElement>("#reshuffle-button")!;
  const resetButton = document.querySelector<HTMLButtonElement>("#reset-button")!;
  const actions = document.querySelector<HTMLDivElement>("#mixer-actions")!;
  const actionsRow = document.querySelector<HTMLDivElement>(".mixer__actions-row")!;
  const pitch = document.querySelector<HTMLDivElement>("#pitch")!;
  const pasteInput = document.querySelector<HTMLTextAreaElement>("#paste-input")!;
  const pasteHint = document.querySelector<HTMLParagraphElement>("#paste-hint")!;

  type Teams = [string[], string[]] | null;
  type Point = { x: number; y: number };

  function esc(value: unknown): string {
    return String(value ?? "").replace(/[&<>"']/g, (ch) =>
      ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      })[ch]!
    );
  }

  function isTeamSize(value: number): boolean {
    return TEAM_SIZES.includes(value);
  }

  const NAME_MAX = 40;

  /**
   * Caps a name over the limit at a word boundary.
   * Cutting mid-word used to turn different players into the same name,
   * and the dedup then dropped them.
   */
  function capName(name: string): string {
    if (name.length <= NAME_MAX) return name;
    const cut = name.slice(0, NAME_MAX);
    const space = cut.lastIndexOf(" ");
    return (space > NAME_MAX * 0.5 ? cut.slice(0, space) : cut).trim();
  }

  /** Accepts `1 mauro`, `1. mauro`, `1) mauro`, bullets, bold and bare lines. */
  function cleanName(raw: string): string {
    let name = raw.replace(/^\s*\[[^\]]{1,40}\]\s*[^:]{1,40}:\s*/, "");

    // Strip up to two leading markers, so `1) - Mauro` still resolves.
    for (let i = 0; i < 2; i += 1) {
      name = name
        .replace(/^\s*(?:[•·▪◦‣✓✔→*_~–—-])+\s*/, "")
        .replace(/^\s*\d{1,2}\s*[.)\-:]?\s*/, "");
    }

    return capName(
      name
        .replace(/^[*_~`"'“”‘’\s]+/, "")
        .replace(/[*_~`"'“”‘’\s]+$/, "")
        .replace(/^[,;]+|[,;]+$/g, "")
        .replace(/\s+/g, " ")
        .trim()
    );
  }

  /** Splits a pasted list into names, whatever list style WhatsApp produced. */
  function splitPasted(text: string): string[] {
    const lines = text.replace(/\r\n?/g, "\n").split("\n");
    const chunks: string[] = [];

    for (const line of lines) {
      if (!line.trim()) continue;

      // A single line can hold several items: `1 Mauro 2 José 3 Santi`.
      const markers = [...line.matchAll(/(?:^|\s)(\d{1,2})\s*[.)\-:]?\s+/g)];
      if (markers.length >= 2) {
        markers.forEach((marker, index) => {
          const start = (marker.index ?? 0) + marker[0].length;
          const end =
            index + 1 < markers.length
              ? markers[index + 1].index ?? line.length
              : line.length;
          chunks.push(line.slice(start, end));
        });
      } else if (/[,;]/.test(line)) {
        chunks.push(...line.split(/[,;]+/));
      } else {
        chunks.push(line);
      }
    }

    const names = chunks.map(cleanName);

    // Headers from the chat ("Jugadores:", "Equipo 1") are not players.
    const headerWords =
      /^(?:jugadores|lista|convocados|plantel|equipos?|partido|fulbito|f[uú]tbol)\b/i;

    return names.filter(
      (name) => name !== "" && !name.endsWith(":") && !headerWords.test(name)
    );
  }

  function dedupeNames(
    names: string[],
    existing: string[]
  ): { fresh: string[]; skipped: number } {
    const seen = new Set(existing.map((name) => name.toLowerCase()));
    const fresh: string[] = [];
    let skipped = 0;

    for (const name of names) {
      const key = name.toLowerCase();
      if (seen.has(key)) {
        skipped += 1;
        continue;
      }
      seen.add(key);
      fresh.push(name);
    }

    return { fresh, skipped };
  }

  /** Every name in the text, cleaned and deduped. Not capped. */
  function parseAll(text: string): string[] {
    const { fresh } = dedupeNames(splitPasted(text), []);
    return fresh;
  }

  /** The line still being typed: everything after the last newline. */
  function parsePending(text: string): string[] {
    const normalized = text.replace(/\r\n?/g, "\n");
    const cut = normalized.lastIndexOf("\n");
    return splitPasted(cut === -1 ? normalized : normalized.slice(cut + 1));
  }

  function load(): { text: string; players: string[]; teams: Teams } {
    let text = "";
    let teams: Teams = null;
    try {
      text = localStorage.getItem(STORAGE_KEYS.list) ?? "";

      // Migration: rosters saved before the list field existed.
      if (text.trim() === "") {
        const legacy = JSON.parse(localStorage.getItem(STORAGE_KEYS.players) ?? "[]");
        if (Array.isArray(legacy)) {
          text = legacy
            .filter((name): name is string => typeof name === "string")
            .join("\n");
        }
      }

      text = text.replace(/\r\n?/g, "\n");
      if (text.trim() !== "" && !text.endsWith("\n")) text += "\n";

      const players = parseAll(text).slice(0, MAX_PLAYERS);
      const rawTeams = JSON.parse(localStorage.getItem(STORAGE_KEYS.teams) ?? "null");
      teams = normalizeTeams(players, rawTeams);
      return { text, players, teams };
    } catch {
      // Corrupted storage: start fresh instead of crashing.
      localStorage.removeItem(STORAGE_KEYS.list);
      localStorage.removeItem(STORAGE_KEYS.players);
      localStorage.removeItem(STORAGE_KEYS.teams);
      return { text: "", players: [], teams: null };
    }
  }

  /** A stored draw is only valid when it is two even, allowed-sized squads. */
  function normalizeTeams(players: string[], raw: unknown): Teams {
    if (!Array.isArray(raw) || raw.length !== 2) return null;
    const [one, two] = raw;
    if (!Array.isArray(one) || !Array.isArray(two)) return null;
    if (one.length !== two.length || !isTeamSize(one.length)) return null;
    const stored = [...one, ...two].map(String).sort().join("|");
    const current = [...players].map(String).sort().join("|");
    return stored === current ? [one.map(String), two.map(String)] : null;
  }

  function save() {
    localStorage.setItem(STORAGE_KEYS.list, pasteInput.value);
    localStorage.setItem(STORAGE_KEYS.players, JSON.stringify(players));
    localStorage.setItem(STORAGE_KEYS.teams, JSON.stringify(teams));
  }

  let { text, players, teams } = load();
  pasteInput.value = text;

  function nearestTotal(count: number): { total: number; diff: number } {
    let best = VALID_TOTALS[0];
    for (const total of VALID_TOTALS) {
      const distance = Math.abs(total - count);
      const bestDistance = Math.abs(best - count);
      if (distance < bestDistance || (distance === bestDistance && total > best)) {
        best = total;
      }
    }
    return { total: best, diff: best - count };
  }

  function ruleMessage(count: number): { text: string; state: "idle" | "ok" | "off" } {
    if (count === 0) {
      return { text: "Mínimo 10 jugadores: dos equipos de 5 y 5.", state: "idle" };
    }
    if (VALID_TOTALS.includes(count)) {
      const size = count / 2;
      return { text: `Listo: ${count} jugadores → ${size} y ${size}.`, state: "ok" };
    }
    const { total, diff } = nearestTotal(count);
    const pair = `${total / 2} y ${total / 2}`;
    const text =
      diff > 0
        ? `Sumá ${diff} jugador${diff === 1 ? "" : "es"} para ${total} (${pair}).`
        : `Te sobra${diff === -1 ? "" : "n"} ${-diff} para ${total} (${pair}).`;
    return { text, state: "off" };
  }

  /**
   * Positions for a known team size using formations.
   *
   * Every player of the team gets its own slot on a vertical grid, and the
   * formation columns deal those slots between them. Two name tags are
   * therefore never at the same height, so they cannot overlap no matter
   * how long the names are.
   */
  function positionsFor(size: number): Point[] {
    const lines = FORMATIONS[size];
    if (!lines) return [];

    const xs = LINE_X[lines.length] ?? [];
    const band = Y_MAX - Y_MIN;
    const keeperSlot = Math.floor((size - 1) / 2);

    // Outfield slots, from the top of the band down, minus the keeper's.
    const slots: number[] = [];
    for (let k = 0; k < size; k += 1) {
      if (k !== keeperSlot) slots.push(k);
    }

    // Deal the slots to the columns, always filling the emptiest one.
    const columns: number[][] = lines.map(() => []);
    slots.forEach((slot) => {
      let target = 0;
      for (let c = 1; c < columns.length; c += 1) {
        const room = columns[c].length < lines[c];
        if (room && columns[c].length < columns[target].length) target = c;
      }
      columns[target].push(slot);
    });

    const slotY = (slot: number) => Y_MIN + ((slot + 0.5) / size) * band;

    const points: Point[] = [{ x: KEEPER_X, y: slotY(keeperSlot) }];
    columns.forEach((column, lineIndex) => {
      const x = xs[lineIndex] ?? 0.3;
      column.forEach((slot) => points.push({ x, y: slotY(slot) }));
    });

    return points;
  }

  /**
   * Slots for a squad. A full side gets its formation; a short or oversized
   * one gets a plain spread so the board still fills up honestly.
   */
  function teamPositions(count: number): Point[] {
    if (count >= 5 && count <= 11) return positionsFor(count);
    return spreadPositions(count);
  }

  /** Evenly spread tokens in columns of at most five, from own goal inward. */
  function spreadPositions(count: number): Point[] {
    if (count <= 0) return [];

    const cols = Math.ceil(count / 5);
    const perCol = Math.ceil(count / cols);
    const points: Point[] = [];

    for (let i = 0; i < count; i++) {
      const col = Math.floor(i / perCol);
      const row = i % perCol;
      const inCol = Math.min(perCol, count - col * perCol);
      const x = cols === 1 ? 0.25 : 0.07 + ((col + 0.5) / cols) * 0.36;
      const y = Y_MIN + ((row + 0.5) / inCol) * (Y_MAX - Y_MIN);
      points.push({ x, y });
    }

    return points;
  }

  function tokenMarkup(name: string, team: 1 | 2, point: Point): string {
    // Team 2 stands mirrored, so both squads face the halfway line.
    const x = team === 1 ? point.x : 1 - point.x;
    const y = team === 1 ? point.y : 1 - point.y;
    const keeper = point.x === KEEPER_X ? ' data-role="keeper"' : "";
    return `
      <div
        class="mixer__token"
        data-team="${team}"${keeper}
        style="--x:${x.toFixed(4)};--y:${y.toFixed(4)}"
        role="listitem"
        aria-label="${esc(name)}, Equipo ${team}"
      >
        <span class="mixer__token-name">${esc(name)}</span>
      </div>
    `;
  }

  function renderPitch(teamOne: string[], teamTwo: string[]): void {
    const onePoints = teamPositions(teamOne.length);
    const twoPoints = teamPositions(teamTwo.length);
    const tokens = [
      ...teamOne.map((name, i) => tokenMarkup(name, 1, onePoints[i])),
      ...teamTwo.map((name, i) => tokenMarkup(name, 2, twoPoints[i])),
    ];

    tokensEl.innerHTML = tokens.join("");
    teamsCount.textContent = `${teamOne.length} y ${teamTwo.length}`;
  }

  /** Provisional split while there is no draw: alternate halves by arrival. */
  function provisionalTeams(): [string[], string[]] {
    const one: string[] = [];
    const two: string[] = [];
    players.forEach((name, index) => (index % 2 === 0 ? one : two).push(name));
    return [one, two];
  }

  function render() {
    // A complete roster mixes itself: there is no button to press.
    if (teams === null && VALID_TOTALS.includes(players.length)) {
      const shuffled = shuffle(players);
      const half = shuffled.length / 2;
      teams = [shuffled.slice(0, half), shuffled.slice(half)];
      save();
    }

    const rule = ruleMessage(players.length);
    ruleEl.dataset.state = rule.state;
    ruleText.textContent = rule.text;

    // The board is always drawn: provisional while there is no draw.
    const [teamOne, teamTwo] = teams ?? provisionalTeams();
    renderPitch(teamOne, teamTwo);

    pitchEmpty.hidden = players.length > 0;
    pitchBadge.hidden = players.length === 0 || teams !== null;
    // The counter and the badge share the same spot: only one of them shows.
    teamsCount.hidden = players.length === 0 || teams === null;

    shareButton.hidden = teams === null;
    copyButton.hidden = teams === null;
    downloadButton.hidden = teams === null;
    reshuffleButton.hidden = teams === null;
    resetButton.hidden = players.length === 0;
    // The row holds the two secondary buttons: hide it when both are gone.
    actionsRow.hidden = reshuffleButton.hidden && resetButton.hidden;
    actions.hidden = shareButton.hidden && copyButton.hidden && downloadButton.hidden && actionsRow.hidden;
  }

  /** Fisher–Yates: uniform shuffle, unlike the biased `sort(() => Math.random() - 0.5)`. */
  function shuffle<T>(list: T[]): T[] {
    const copy = [...list];
    for (let i = copy.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [copy[i], copy[j]] = [copy[j], copy[i]];
    }
    return copy;
  }

  function updatePastePreview() {
    const total = parseAll(pasteInput.value).length;
    if (total > MAX_PLAYERS) {
      pasteHint.textContent = `Entran ${MAX_PLAYERS} de ${total}: el máximo es ${MAX_PLAYERS} (11 y 11).`;
      return;
    }

    // Only the line being typed is pending: the rest is already on the pitch.
    const pending = parsePending(pasteInput.value);
    const { fresh, skipped } = dedupeNames(pending, players);

    if (pending.length === 0) {
      pasteHint.textContent =
        players.length === 0
          ? "Escribí un nombre y apretá Enter, o pegá la lista completa."
          : `${players.length} jugador${
              players.length === 1 ? "" : "es"
            } en la cancha · Enter para sumar otro.`;
      return;
    }

    if (fresh.length === 0) {
      pasteHint.textContent =
        skipped === 1
          ? "Ese jugador ya está en la lista."
          : `Los ${skipped} nombres ya están en la lista.`;
      return;
    }

    const room = Math.max(0, MAX_PLAYERS - players.length);
    if (fresh.length > room) {
      pasteHint.textContent = `Entran ${room} de ${fresh.length}: el máximo es ${MAX_PLAYERS} (11 y 11).`;
      return;
    }

    const skippedNote =
      skipped > 0
        ? ` · ${skipped} duplicado${skipped === 1 ? "" : "s"} salteado${
            skipped === 1 ? "" : "s"
          }`
        : "";

    pasteHint.textContent =
      fresh.length === 1
        ? `1 jugador listo · Enter para sumar${skippedNote}.`
        : `${fresh.length} jugadores listos · Enter para sumar${skippedNote}.`;
  }

  /**
   * The field IS the list: every name in it becomes a player on the pitch.
   * Enter, paste and blur all land here, so there is no button to press.
   */
  function commitList(): boolean {
    const raw = pasteInput.value.replace(/\r\n?/g, "\n");
    if (raw.trim() === "") return false;

    const names = parseAll(raw).slice(0, MAX_PLAYERS);
    if (names.length === 0) return false;

    // The list stays visible in the field, with the caret on a fresh line.
    const next = raw.endsWith("\n") ? raw : `${raw}\n`;
    if (pasteInput.value !== next) pasteInput.value = next;
    pasteInput.setSelectionRange(next.length, next.length);

    const changed = names.join("\u0000") !== players.join("\u0000");
    players = names;
    if (changed) teams = null;

    save();
    render();
    updatePastePreview();
    return true;
  }

  pasteInput.addEventListener("input", updatePastePreview);

  // Enter commits the name being typed and drops the caret on a new line.
  pasteInput.addEventListener("keydown", (event) => {
    if (event.key === "Enter") {
      event.preventDefault();
      commitList();
      return;
    }
    if (event.key === "Escape" && pasteInput.value !== "") {
      event.preventDefault();
      pasteInput.value = "";
      updatePastePreview();
    }
  });

  // A pasted list lands without touching anything: the browser fires input
  // after the paste, so commit on the next tick with the final value.
  pasteInput.addEventListener("paste", () => {
    window.setTimeout(() => {
      if (pasteInput.value.trim() === "") return;
      commitList();
      // The board is the payoff of a paste: bring it into view.
      // Only on paste: while typing, scrolling would fight the caret.
      const smooth = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      pitch.scrollIntoView({ behavior: smooth ? "smooth" : "auto", block: "center" });
    }, 0);
  });

  pasteInput.addEventListener("blur", () => {
    if (pasteInput.value.trim() !== "") commitList();
  });

  // Clicking a button must not blur the field (that would commit a half-typed name).
  for (const button of [shareButton, copyButton, downloadButton, reshuffleButton, resetButton]) {
    button.addEventListener("mousedown", (event) => event.preventDefault());
  }

  function teamsText(): string {
    if (teams === null) return "";
    const [teamOne, teamTwo] = teams;
    return [
      "MiXteam — Equipos mezclados",
      "",
      `Equipo 1 (${teamOne.length})`,
      ...teamOne.map((name, i) => `${i + 1}. ${name}`),
      "",
      `Equipo 2 (${teamTwo.length})`,
      ...teamTwo.map((name, i) => `${i + 1}. ${name}`),
    ].join("\n");
  }

  reshuffleButton.addEventListener("click", () => {
    if (!VALID_TOTALS.includes(players.length)) return;
    const shuffled = shuffle(players);
    const half = shuffled.length / 2;
    teams = [shuffled.slice(0, half), shuffled.slice(half)];
    save();
    render();
  });

  shareButton.addEventListener("click", () => {
    if (teams === null) return;
    window.open(`https://wa.me/?text=${encodeURIComponent(teamsText())}`, "_blank", "noopener");
  });

  let copyResetTimer: number | undefined;
  copyButton.addEventListener("click", async () => {
    if (teams === null) return;
    const text = teamsText();
    let ok = false;
    try {
      await navigator.clipboard.writeText(text);
      ok = true;
    } catch {
      // Clipboard API can fail without focus/permission: fall back to the
      // legacy textarea + execCommand path, still in a user gesture.
      const probe = document.createElement("textarea");
      probe.value = text;
      probe.setAttribute("readonly", "");
      probe.style.position = "fixed";
      probe.style.opacity = "0";
      document.body.appendChild(probe);
      probe.select();
      try {
        ok = document.execCommand("copy");
      } catch {
        ok = false;
      }
      probe.remove();
    }
    copyButton.textContent = ok ? "¡Copiado!" : "No se pudo copiar";
    window.clearTimeout(copyResetTimer);
    copyResetTimer = window.setTimeout(() => {
      copyButton.textContent = "Copiar equipos";
    }, 1800);
  });

  function downloadPitchImage(): void {
    if (teams === null) return;
    const [teamOne, teamTwo] = teams;

    const W = 1600;
    const H = Math.round(W / 2.05);
    const canvas = document.createElement("canvas");
    canvas.width = W;
    canvas.height = H;
    const ctx = canvas.getContext("2d")!;
    if (!ctx) return;

    // Background: same greens as the CSS variables.
    const grad = ctx.createLinearGradient(0, 0, 0, H);
    grad.addColorStop(0, "#1a6b48");
    grad.addColorStop(1, "#0e3f2c");
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);

    // Pitch lines (viewBox 1088x440 mapped onto the canvas).
    const sx = W / 1088;
    const sy = H / 440;
    ctx.strokeStyle = "#4faa80";
    ctx.lineWidth = 2.5;
    const rect = (x: number, y: number, w: number, h: number, r = 0) => {
      ctx.beginPath();
      ctx.roundRect(x * sx, y * sy, w * sx, h * sy, r * sx);
      ctx.stroke();
    };
    rect(16, 16, 1056, 408, 10);
    ctx.beginPath();
    ctx.moveTo(544 * sx, 16 * sy);
    ctx.lineTo(544 * sx, 424 * sy);
    ctx.stroke();
    ctx.beginPath();
    ctx.arc(544 * sx, 220 * sy, 72 * sx, 0, Math.PI * 2);
    ctx.stroke();
    ctx.fillStyle = "#4faa80";
    ctx.beginPath();
    ctx.arc(544 * sx, 220 * sy, 4 * sx, 0, Math.PI * 2);
    ctx.fill();
    rect(16, 120, 112, 200);
    rect(960, 120, 112, 200);
    rect(16, 168, 46, 104);
    rect(1026, 168, 46, 104);

    // Half labels.
    ctx.font = "800 26px Inter, system-ui, sans-serif";
    ctx.textAlign = "left";
    ctx.fillStyle = "#d9ff8c";
    ctx.fillText("EQUIPO 1", 40, 52);
    ctx.textAlign = "right";
    ctx.fillStyle = "#eaf6ef";
    ctx.fillText("EQUIPO 2", W - 40, 52);

    // Center count pill.
    const pill = `${teamOne.length} y ${teamTwo.length}`;
    ctx.font = "800 24px Inter, system-ui, sans-serif";
    const pillW = ctx.measureText(pill).width + 44;
    const pillX = W / 2 - pillW / 2;
    ctx.fillStyle = "rgba(8,18,14,0.85)";
    ctx.beginPath();
    ctx.roundRect(pillX, 28, pillW, 44, 22);
    ctx.fill();
    ctx.strokeStyle = "rgba(182,240,74,0.5)";
    ctx.lineWidth = 2;
    ctx.stroke();
    ctx.textAlign = "center";
    ctx.fillStyle = "#d9ff8c";
    ctx.fillText(pill, W / 2, 58);

    // Tokens: one pill per player, same positions as the DOM board.
    const drawTeam = (names: string[], mirror: boolean, colors: string) => {
      const points = teamPositions(names.length);
      names.forEach((name, i) => {
        const p = points[i];
        const fx = mirror ? 1 - p.x : p.x;
        const fy = mirror ? 1 - p.y : p.y;
        const isKeeper = p.x === KEEPER_X;
        const cx = fx * W;
        const cy = fy * H;
        ctx.font = "700 22px Inter, system-ui, sans-serif";
        const label = name.length > 22 ? `${name.slice(0, 21)}…` : name;
        const textW = ctx.measureText(label).width;
        const padX = 16;
        const w = textW + padX * 2;
        const h = 40;
        const x = isKeeper ? (mirror ? cx - w : cx) : cx - w / 2;
        const y = cy - h / 2;
        ctx.fillStyle = colors;
        ctx.beginPath();
        ctx.roundRect(x, y, w, h, 20);
        ctx.fill();
        ctx.fillStyle = colors === "#b6f04a" ? "#14260a" : "#14260a";
        ctx.textAlign = "left";
        ctx.fillText(label, x + padX, y + h / 2 + 7);
      });
    };
    drawTeam(teamOne, false, "#b6f04a");
    drawTeam(teamTwo, true, "#eaf6ef");

    // Footer brand.
    ctx.font = "600 24px Inter, system-ui, sans-serif";
    ctx.textAlign = "right";
    ctx.fillStyle = "rgba(234,246,239,0.85)";
    ctx.fillText("MiXteam", W - 36, H - 26);

    canvas.toBlob((blob) => {
      if (!blob) return;
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `mixteam-${teamOne.length}v${teamTwo.length}.png`;
      a.click();
      window.setTimeout(() => URL.revokeObjectURL(url), 4000);
    }, "image/png");
  }

  downloadButton.addEventListener("click", () => {
    if (teams === null) return;
    downloadButton.textContent = "Generando…";
    // Next tick so the label paints before the heavy canvas work blocks.
    window.setTimeout(() => {
      try {
        downloadPitchImage();
      } finally {
        downloadButton.textContent = "Descargar imagen";
      }
    }, 0);
  });

  resetButton.addEventListener("click", () => {
    players = [];
    teams = null;
    pasteInput.value = "";
    save();
    render();
    updatePastePreview();
    pasteInput.focus();
  });

  updatePastePreview();
  render();
</script>

