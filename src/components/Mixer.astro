---
// Team mixer island: the star feature of the site.
// The output is a football-pitch board: both squads stand on their own half.
// Product rule: teams must be even and 5, 6, 7, 8, 9 or 11 players per side.
// Legacy reference: legacy/js/index.js
---

<section class="mixer" aria-labelledby="mixer-title">
  <div class="mixer__hero">
    <h1 id="mixer-title">Crea tus equipos</h1>
    <p class="mixer__lead">
      Armá los equipos para ese fulbito. Equipos parejos de 5, 6, 7, 8, 9 u 11
      por lado.
    </p>

    <form class="mixer__form" id="mixer-form">
      <label class="mixer__form-label" for="paste-input">
        Pegá la lista del grupo o escribí los nombres
      </label>
      <textarea
        class="field mixer__form-input"
        id="paste-input"
        rows="5"
        placeholder={"1. Mauro\n2. José\n3. Santi"}
        spellcheck="false"
      ></textarea>
      <p class="mixer__form-hint" id="paste-hint" aria-live="polite">
        Una por línea, numeradas, con viñetas o separadas por comas.
      </p>
      <div class="mixer__form-actions">
        <button class="btn btn--soft" type="submit" id="paste-add" disabled>
          Agregar jugadores
        </button>
      </div>
    </form>

    <div class="mixer__meta">
      <p class="mixer__rule" id="mixer-rule" aria-live="polite" data-state="idle">
        <svg
          class="mixer__rule-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        <span id="mixer-rule-text">Mínimo 10 jugadores: dos equipos de 5 y 5.</span>
      </p>

      <button class="btn" type="button" id="mix-button" disabled>Mezclar</button>
    </div>
  </div>

  <section class="mixer__roster" aria-labelledby="roster-title">
    <div class="mixer__section-head mixer__section-head--center">
      <h2 id="roster-title">Jugadores</h2>
      <span class="mixer__chip" id="players-count">0</span>
    </div>
    <ul class="mixer__players" id="player-list" aria-label="Jugadores agregados"></ul>
  </section>

  <section class="mixer__output" id="mixer-output" aria-labelledby="teams-title">
    <div class="mixer__section-head">
      <h2 id="teams-title">Equipos</h2>
      <span class="mixer__chip" id="teams-count"></span>
    </div>

    <div class="mixer__pitch" id="pitch">
      <div class="mixer__pitch-lines" aria-hidden="true">
        <svg viewBox="0 0 1088 440" preserveAspectRatio="none">
          <rect x="16" y="16" width="1056" height="408" rx="10"></rect>
          <line x1="544" y1="16" x2="544" y2="424"></line>
          <circle cx="544" cy="220" r="72"></circle>
          <circle cx="544" cy="220" r="4" class="mixer__spot"></circle>
          <rect x="16" y="120" width="112" height="200"></rect>
          <rect x="960" y="120" width="112" height="200"></rect>
          <rect x="16" y="168" width="46" height="104"></rect>
          <rect x="1026" y="168" width="46" height="104"></rect>
        </svg>
      </div>
      <span class="mixer__half-label mixer__half-label--one">Equipo 1</span>
      <span class="mixer__half-label mixer__half-label--two">Equipo 2</span>
      <div class="mixer__tokens" id="tokens" role="list" aria-label="Formación de los equipos"></div>
      <p class="mixer__pitch-empty" id="pitch-empty">
        Agregá jugadores y la cancha se arma sola
      </p>
      <span class="mixer__pitch-badge" id="pitch-badge" hidden>Provisorio</span>
    </div>

    <div class="mixer__pitch-roster" id="pitch-roster" aria-hidden="true"></div>
  </section>

  <div class="mixer__actions" id="mixer-actions" hidden>
    <button class="btn btn--whatsapp" type="button" id="share-button" hidden>
      Compartir en WhatsApp
    </button>
    <button class="btn btn--ghost" type="button" id="reset-button" hidden>
      Empezar de nuevo
    </button>
  </div>
</section>

<script>
  const STORAGE_KEYS = {
    players: "mixteam:players",
    teams: "mixteam:teams",
  } as const;

  /** Team sizes allowed by the product: even sides only. */
  const TEAM_SIZES: readonly number[] = [5, 6, 7, 8, 9, 11];
  const VALID_TOTALS = TEAM_SIZES.map((size) => size * 2);
  const MAX_PLAYERS = Math.max(...VALID_TOTALS);

  /** Outfield lines per team size; the keeper is always implicit. */
  const FORMATIONS: Record<number, readonly number[]> = {
    5: [2, 2],
    6: [2, 2, 1],
    7: [3, 2, 1],
    8: [3, 3, 1],
    9: [3, 3, 2],
    11: [4, 4, 2],
  };

  /** Horizontal fractions inside one half, from own goal to halfway line. */
  const LINE_X: Record<number, readonly number[]> = {
    2: [0.24, 0.385],
    3: [0.18, 0.285, 0.385],
    4: [0.145, 0.225, 0.305, 0.385],
  };

  const KEEPER_X = 0.065;
  const Y_MIN = 0.12;
  const Y_MAX = 0.88;

  const form = document.querySelector<HTMLFormElement>("#mixer-form")!;
  const mixButton = document.querySelector<HTMLButtonElement>("#mix-button")!;
  const ruleEl = document.querySelector<HTMLParagraphElement>("#mixer-rule")!;
  const ruleText = document.querySelector<HTMLSpanElement>("#mixer-rule-text")!;
  const playersCount = document.querySelector<HTMLSpanElement>("#players-count")!;
  const playerList = document.querySelector<HTMLUListElement>("#player-list")!;
  const teamsCount = document.querySelector<HTMLSpanElement>("#teams-count")!;
  const tokensEl = document.querySelector<HTMLDivElement>("#tokens")!;
  const pitchEmpty = document.querySelector<HTMLParagraphElement>("#pitch-empty")!;
  const pitchBadge = document.querySelector<HTMLSpanElement>("#pitch-badge")!;
  const pitchRoster = document.querySelector<HTMLDivElement>("#pitch-roster")!;
  const shareButton = document.querySelector<HTMLButtonElement>("#share-button")!;
  const resetButton = document.querySelector<HTMLButtonElement>("#reset-button")!;
  const actions = document.querySelector<HTMLDivElement>("#mixer-actions")!;
  const pasteInput = document.querySelector<HTMLTextAreaElement>("#paste-input")!;
  const pasteHint = document.querySelector<HTMLParagraphElement>("#paste-hint")!;
  const pasteAdd = document.querySelector<HTMLButtonElement>("#paste-add")!;

  type Teams = [string[], string[]] | null;
  type Point = { x: number; y: number };

  function esc(value: unknown): string {
    return String(value ?? "").replace(/[&<>"']/g, (ch) =>
      ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      })[ch]!
    );
  }

  function isTeamSize(value: number): boolean {
    return TEAM_SIZES.includes(value);
  }

  const NAME_MAX = 20;

  /** Accepts `1 mauro`, `1. mauro`, `1) mauro`, bullets, bold and bare lines. */
  function cleanName(raw: string): string {
    let name = raw.replace(/^\s*\[[^\]]{1,40}\]\s*[^:]{1,40}:\s*/, "");

    // Strip up to two leading markers, so `1) - Mauro` still resolves.
    for (let i = 0; i < 2; i += 1) {
      name = name
        .replace(/^\s*(?:[•·▪◦‣✓✔→*_~–—-])+\s*/, "")
        .replace(/^\s*\d{1,2}\s*[.)\-:]?\s*/, "");
    }

    return name
      .replace(/^[*_~`"'“”‘’\s]+/, "")
      .replace(/[*_~`"'“”‘’\s]+$/, "")
      .replace(/^[,;]+|[,;]+$/g, "")
      .replace(/\s+/g, " ")
      .trim()
      .slice(0, NAME_MAX);
  }

  /** Splits a pasted list into names, whatever list style WhatsApp produced. */
  function splitPasted(text: string): string[] {
    const lines = text.replace(/\r\n?/g, "\n").split("\n");
    const chunks: string[] = [];

    for (const line of lines) {
      if (!line.trim()) continue;

      // A single line can hold several items: `1 Mauro 2 José 3 Santi`.
      const markers = [...line.matchAll(/(?:^|\s)(\d{1,2})\s*[.)\-:]?\s+/g)];
      if (markers.length >= 2) {
        markers.forEach((marker, index) => {
          const start = (marker.index ?? 0) + marker[0].length;
          const end =
            index + 1 < markers.length
              ? markers[index + 1].index ?? line.length
              : line.length;
          chunks.push(line.slice(start, end));
        });
      } else if (/[,;]/.test(line)) {
        chunks.push(...line.split(/[,;]+/));
      } else {
        chunks.push(line);
      }
    }

    const names = chunks.map(cleanName);

    // Headers from the chat ("Jugadores:", "Equipo 1") are not players.
    const headerWords =
      /^(?:jugadores|lista|convocados|plantel|equipos?|partido|fulbito|f[uú]tbol)\b/i;

    return names.filter(
      (name) => name !== "" && !name.endsWith(":") && !headerWords.test(name)
    );
  }

  function dedupeNames(
    names: string[],
    existing: string[]
  ): { fresh: string[]; skipped: number } {
    const seen = new Set(existing.map((name) => name.toLowerCase()));
    const fresh: string[] = [];
    let skipped = 0;

    for (const name of names) {
      const key = name.toLowerCase();
      if (seen.has(key)) {
        skipped += 1;
        continue;
      }
      seen.add(key);
      fresh.push(name);
    }

    return { fresh, skipped };
  }

  function load(): { players: string[]; teams: Teams } {
    let players: string[] = [];
    let teams: Teams = null;
    try {
      const rawPlayers = JSON.parse(localStorage.getItem(STORAGE_KEYS.players) ?? "[]");
      const rawTeams = JSON.parse(localStorage.getItem(STORAGE_KEYS.teams) ?? "null");
      if (Array.isArray(rawPlayers)) {
        players = rawPlayers.filter((name): name is string => typeof name === "string");
      }
      teams = normalizeTeams(players, rawTeams);
    } catch {
      // Corrupted storage: start fresh instead of crashing.
      localStorage.removeItem(STORAGE_KEYS.players);
      localStorage.removeItem(STORAGE_KEYS.teams);
    }
    return { players, teams };
  }

  /** A stored draw is only valid when it is two even, allowed-sized squads. */
  function normalizeTeams(players: string[], raw: unknown): Teams {
    if (!Array.isArray(raw) || raw.length !== 2) return null;
    const [one, two] = raw;
    if (!Array.isArray(one) || !Array.isArray(two)) return null;
    if (one.length !== two.length || !isTeamSize(one.length)) return null;
    const stored = [...one, ...two].map(String).sort().join("|");
    const current = [...players].map(String).sort().join("|");
    return stored === current ? [one.map(String), two.map(String)] : null;
  }

  function save() {
    localStorage.setItem(STORAGE_KEYS.players, JSON.stringify(players));
    localStorage.setItem(STORAGE_KEYS.teams, JSON.stringify(teams));
  }

  let { players, teams } = load();

  function nearestTotal(count: number): { total: number; diff: number } {
    let best = VALID_TOTALS[0];
    for (const total of VALID_TOTALS) {
      const distance = Math.abs(total - count);
      const bestDistance = Math.abs(best - count);
      if (distance < bestDistance || (distance === bestDistance && total > best)) {
        best = total;
      }
    }
    return { total: best, diff: best - count };
  }

  function ruleMessage(count: number): { text: string; state: "idle" | "ok" | "off" } {
    if (count === 0) {
      return { text: "Mínimo 10 jugadores: dos equipos de 5 y 5.", state: "idle" };
    }
    if (VALID_TOTALS.includes(count)) {
      const size = count / 2;
      return { text: `Listo: ${count} jugadores → ${size} y ${size}.`, state: "ok" };
    }
    const { total, diff } = nearestTotal(count);
    const pair = `${total / 2} y ${total / 2}`;
    const text =
      diff > 0
        ? `Sumá ${diff} jugador${diff === 1 ? "" : "es"} para ${total} (${pair}).`
        : `Te sobra${diff === -1 ? "" : "n"} ${-diff} para ${total} (${pair}).`;
    return { text, state: "off" };
  }

  function positionsFor(size: number): Point[] {
    const lines = FORMATIONS[size];
    if (!lines) return [];

    const points: Point[] = [{ x: KEEPER_X, y: 0.5 }];
    const xs = LINE_X[lines.length] ?? [];

    lines.forEach((count, lineIndex) => {
      const x = xs[lineIndex] ?? 0.3;
      for (let i = 0; i < count; i++) {
        const step = (i + 1) / (count + 1);
        points.push({ x, y: Y_MIN + step * (Y_MAX - Y_MIN) });
      }
    });

    return points;
  }

  /**
   * Slots for a squad. A full side gets its formation; a short or oversized
   * one gets a plain spread so the board still fills up honestly.
   */
  function teamPositions(count: number): Point[] {
    if (count >= 5 && count <= 11) return positionsFor(count);
    return spreadPositions(count);
  }

  /** Evenly spread tokens in columns of at most five, from own goal inward. */
  function spreadPositions(count: number): Point[] {
    if (count <= 0) return [];

    const cols = Math.ceil(count / 5);
    const perCol = Math.ceil(count / cols);
    const points: Point[] = [];

    for (let i = 0; i < count; i++) {
      const col = Math.floor(i / perCol);
      const row = i % perCol;
      const inCol = Math.min(perCol, count - col * perCol);
      const x = cols === 1 ? 0.25 : 0.07 + ((col + 0.5) / cols) * 0.36;
      const y = Y_MIN + ((row + 0.5) / inCol) * (Y_MAX - Y_MIN);
      points.push({ x, y });
    }

    return points;
  }

  function tokenMarkup(name: string, team: 1 | 2, point: Point): string {
    const x = team === 1 ? point.x : 1 - point.x;
    const initial = name.trim().charAt(0).toUpperCase() || "?";
    return `
      <div
        class="mixer__token"
        data-team="${team}"
        style="--x:${x.toFixed(4)};--y:${point.y.toFixed(4)}"
        role="listitem"
        aria-label="${esc(name)}, Equipo ${team}"
      >
        <span class="mixer__disc" aria-hidden="true">${esc(initial)}</span>
        <span class="mixer__token-name">${esc(name)}</span>
      </div>
    `;
  }

  function renderPitch(teamOne: string[], teamTwo: string[]): void {
    const onePoints = teamPositions(teamOne.length);
    const twoPoints = teamPositions(teamTwo.length);
    const tokens = [
      ...teamOne.map((name, i) => tokenMarkup(name, 1, onePoints[i])),
      ...teamTwo.map((name, i) => tokenMarkup(name, 2, twoPoints[i])),
    ];

    tokensEl.innerHTML = tokens.join("");
    teamsCount.hidden = teamOne.length + teamTwo.length === 0;
    teamsCount.textContent = `${teamOne.length} y ${teamTwo.length}`;
    pitchRoster.hidden = teamOne.length + teamTwo.length === 0;
    pitchRoster.innerHTML = [
      { team: 1, label: "Equipo 1", members: teamOne },
      { team: 2, label: "Equipo 2", members: teamTwo },
    ]
      .map(
        (squad) => `
          <div class="mixer__pitch-roster-team" data-team="${squad.team}">
            <p class="mixer__pitch-roster-label">${squad.label}</p>
            <ul>${squad.members.map((name) => `<li>${esc(name)}</li>`).join("")}</ul>
          </div>
        `
      )
      .join("");
  }

  function renderPlayers() {
    playersCount.textContent = String(players.length);
    playerList.replaceChildren();

    if (players.length === 0) {
      const li = document.createElement("li");
      li.className = "mixer__empty";
      li.textContent = "Todavía no hay jugadores. Agregá el primero 👆";
      playerList.appendChild(li);
      return;
    }

    players.forEach((player, index) => {
      const li = document.createElement("li");
      li.className = "mixer__player";

      const label = document.createElement("span");
      label.className = "mixer__player-name";
      label.textContent = player;

      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = "mixer__remove";
      remove.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="M6 6l12 12"></path></svg>`;
      remove.setAttribute("aria-label", `Quitar a ${player}`);
      remove.addEventListener("click", () => {
        players.splice(index, 1);
        // Changing the roster invalidates the current draw.
        teams = null;
        save();
        render();
      });

      li.append(label, remove);
      playerList.appendChild(li);
    });
  }

  /** Provisional split while there is no draw: alternate halves by arrival. */
  function provisionalTeams(): [string[], string[]] {
    const one: string[] = [];
    const two: string[] = [];
    players.forEach((name, index) => (index % 2 === 0 ? one : two).push(name));
    return [one, two];
  }

  function render() {
    renderPlayers();

    const rule = ruleMessage(players.length);
    ruleEl.dataset.state = rule.state;
    ruleText.textContent = rule.text;

    mixButton.disabled = !VALID_TOTALS.includes(players.length);

    // The board is always drawn: provisional while there is no draw.
    const [teamOne, teamTwo] = teams ?? provisionalTeams();
    renderPitch(teamOne, teamTwo);

    pitchEmpty.hidden = players.length > 0;
    pitchBadge.hidden = players.length === 0 || teams !== null;

    shareButton.hidden = teams === null;
    resetButton.hidden = players.length === 0 && teams === null;
    actions.hidden = shareButton.hidden && resetButton.hidden;
  }

  /** Fisher–Yates: uniform shuffle, unlike the biased `sort(() => Math.random() - 0.5)`. */
  function shuffle<T>(list: T[]): T[] {
    const copy = [...list];
    for (let i = copy.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [copy[i], copy[j]] = [copy[j], copy[i]];
    }
    return copy;
  }

  function updatePastePreview() {
    const parsed = splitPasted(pasteInput.value);
    const { fresh, skipped } = dedupeNames(parsed, players);

    pasteAdd.disabled = fresh.length === 0;
    pasteAdd.textContent =
      fresh.length === 0
        ? "Agregar jugadores"
        : fresh.length === 1
          ? "Agregar 1 jugador"
          : `Agregar ${fresh.length} jugadores`;

    if (parsed.length === 0) {
      pasteHint.textContent =
        "Una por línea, numeradas, con viñetas o separadas por comas.";
      return;
    }

    if (fresh.length === 0) {
      pasteHint.textContent =
        skipped === 1
          ? "Ese jugador ya está en la lista."
          : `Los ${skipped} nombres ya están en la lista.`;
      return;
    }

    const skippedNote =
      skipped > 0
        ? ` · ${skipped} duplicado${skipped === 1 ? "" : "s"} salteado${
            skipped === 1 ? "" : "s"
          }`
        : "";

    const room = Math.max(0, MAX_PLAYERS - players.length);
    if (fresh.length > room) {
      pasteHint.textContent = `Entran ${room} de ${fresh.length}: el máximo es ${MAX_PLAYERS} (11 y 11).`;
      return;
    }

    pasteHint.textContent =
      fresh.length === 1
        ? `1 jugador para agregar${skippedNote}.`
        : `${fresh.length} jugadores para agregar${skippedNote}.`;
  }

  /** Single entry point: the textarea is both the paste target and manual entry. */
  form.addEventListener("submit", (event) => {
    event.preventDefault();
    const { fresh } = dedupeNames(splitPasted(pasteInput.value), players);
    if (fresh.length === 0) return;

    const room = Math.max(0, MAX_PLAYERS - players.length);
    if (room === 0) {
      pasteHint.textContent = `Ya tenés ${MAX_PLAYERS} jugadores: es el máximo (11 y 11).`;
      return;
    }

    players.push(...fresh.slice(0, room));
    teams = null;
    save();
    render();

    // Anything past the cap stays in the field instead of vanishing.
    pasteInput.value = fresh.slice(room).join("\n");
    updatePastePreview();
    pasteInput.focus();
  });

  pasteInput.addEventListener("input", updatePastePreview);

  // Enter inserts a line, so Ctrl/Cmd+Enter adds the whole list.
  pasteInput.addEventListener("keydown", (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key === "Enter") {
      event.preventDefault();
      form.requestSubmit();
    }
  });

  mixButton.addEventListener("click", () => {
    if (!VALID_TOTALS.includes(players.length)) return;
    const shuffled = shuffle(players);
    const half = shuffled.length / 2;
    teams = [shuffled.slice(0, half), shuffled.slice(half)];
    save();
    render();
  });

  shareButton.addEventListener("click", () => {
    if (teams === null) return;
    const [teamOne, teamTwo] = teams;
    const text = [
      "MiXteam — Tus equipos mezclados!",
      `Equipo 1 (${teamOne.length}): ${teamOne.join(", ")}`,
      `Equipo 2 (${teamTwo.length}): ${teamTwo.join(", ")}`,
    ].join("\n");
    window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, "_blank", "noopener");
  });

  resetButton.addEventListener("click", () => {
    players = [];
    teams = null;
    save();
    pasteInput.value = "";
    updatePastePreview();
    render();
    pasteInput.focus();
  });

  updatePastePreview();
  render();
</script>

<style is:global>
  .mixer {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  /* ----- Hero ----- */
  .mixer__hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  .mixer h1 {
    margin: 0;
  }

  .mixer__lead {
    max-width: 44ch;
    color: var(--color-text-muted);
    font-size: var(--text-md);
  }

  .mixer__form {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    width: min(100%, 49rem);
    margin-top: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    text-align: left;
  }

  .mixer__form-label {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .mixer__form-input {
    min-height: 8.5rem;
    resize: vertical;
    background: var(--color-bg);
    font-family: inherit;
    line-height: 1.5;
  }

  .mixer__form-hint {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .mixer__form-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  /* ----- Rule chip + mix action ----- */
  .mixer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.6rem 0.9rem;
  }

  .mixer__rule {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid #26382c;
    background: var(--color-surface-soft);
    color: #bfd3c6;
