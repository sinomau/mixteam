---
// Data-driven sports view shared by the three competition pages.
// Tabs render standings, results, upcoming fixtures and live matches.
// All data flows through the /api/football server proxy — no API keys
// ever reach the browser. Legacy reference: legacy/js/api.js
interface Props {
  heading: string;
  logo: string;
  logoAlt: string;
  endpoint: string;
}

const { heading, logo, logoAlt, endpoint } = Astro.props;
---

<section class="fb" data-endpoint={endpoint} aria-labelledby="fb-heading">
  <div class="section-title">
    <h2 id="fb-heading">{heading}</h2>
    <img src={logo} alt={logoAlt} loading="eager" class="fb__comp-logo" />
  </div>

  <div class="fb__tabs" role="tablist" aria-label="Qué ver">
    <button class="fb__tab" role="tab" data-view="standings" aria-selected="true">
      Tabla de posiciones
    </button>
    <button class="fb__tab" role="tab" data-view="last" aria-selected="false">
      Resultados
    </button>
    <button class="fb__tab" role="tab" data-view="next" aria-selected="false">
      Próximos partidos
    </button>
    <button class="fb__tab" role="tab" data-view="live" aria-selected="false">
      En vivo
    </button>
  </div>

  <div class="fb__panel" aria-live="polite"></div>
</section>

<script>
  const section = document.querySelector<HTMLElement>(".fb")!;
  const endpoint = section.dataset.endpoint!;
  const tabs = [...section.querySelectorAll<HTMLButtonElement>(".fb__tab")];
  const panel = section.querySelector<HTMLDivElement>(".fb__panel")!;

  const CACHE_TTL_MS = 5 * 60 * 1000;
  const cache = new Map<string, { html: string; at: number }>();
  let activeTab: string | null = null;
  let inFlight = false;

  const spinner = `<div class="fb__loading" role="status">Cargando…</div>`;
  const errorMessage = `
    <div class="fb__error">
      <p>El contenido no está disponible en este momento.</p>
      <p><button class="btn btn--ghost fb__retry">Reintentar</button></p>
    </div>
  `;

  function setLoading() {
    panel.innerHTML = spinner;
  }

  function setError() {
    panel.innerHTML = errorMessage;
    panel
      .querySelector(".fb__retry")
      ?.addEventListener("click", () => {
        activeTab = null;
        load("standings");
      });
  }

  function setHtml(html: string) {
    panel.innerHTML = html;
  }

  function cacheSet(key: string, html: string) {
    cache.set(key, { html, at: Date.now() });
  }

  function cacheGet(key: string): string | null {
    const cached = cache.get(key);
    if (cached && Date.now() - cached.at < CACHE_TTL_MS) return cached.html;
    return null;
  }

  function esc(value: unknown): string {
    return String(value ?? "").replace(/[&<>"']/g, (ch) =>
      ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      })[ch]!
    );
  }

  function fmtDate(iso: string): string {
    return new Date(iso).toLocaleString("es-AR", {
      weekday: "short",
      day: "2-digit",
      month: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  function statusLabel(status: string): string {
    const labels: Record<string, string> = {
      "Por jugar": "Por jugar",
      "Finalizado": "Finalizado",
      "En vivo": "En vivo",
    };
    return labels[status] ?? status;
  }

  function clubMarkup(club: string, logo: string, align: "left" | "right"): string {
    const img = logo
      ? `<img class="fb__club-logo" src="${esc(logo)}" alt="" width="26" height="26" loading="lazy">`
      : `<span class="fb__club-logo fb__club-logo--placeholder" aria-hidden="true"></span>`;
    return align === "left"
      ? `${img}<span>${esc(club)}</span>`
      : `<span>${esc(club)}</span>${img}`;
  }

  function renderStandings(groups: Array<{ groupName: string; rows: Array<Record<string, unknown>> }>): string {
    if (groups.length === 0) {
      return `<div class="fb__empty">Todavía no hay tabla publicada para esta competencia.</div>`;
    }
    return groups
      .map(({ groupName, rows }) => {
        const body = rows
          .map(
            (r) => `
            <tr>
              <td class="fb__num-cell">${esc(r.rank)}</td>
              <td class="fb__club-cell">
                <img class="fb__table-logo" src="${esc(r.logo)}" alt="" width="22" height="22" loading="lazy">
                <span>${esc(r.team)}</span>
              </td>
              <td class="fb__num-cell">${esc(r.played)}</td>
              <td class="fb__num-cell">${esc(r.win)}</td>
              <td class="fb__num-cell">${esc(r.draw)}</td>
              <td class="fb__num-cell">${esc(r.lose)}</td>
              <td class="fb__num-cell fb__dim">${esc(r.goalsFor)}</td>
              <td class="fb__num-cell fb__dim">${esc(r.goalsAgainst)}</td>
              <td class="fb__num-cell fb__dim">${esc(r.diff)}</td>
              <td class="fb__num-cell fb__pts">${esc(r.points)}</td>
            </tr>
          `
          )
          .join("");
        return `
          <h3 class="fb__group-title">${esc(groupName)}</h3>
          <figure class="fb__table-wrap">
            <table>
              <thead>
                <tr>
                  <th class="fb__num-cell">#</th>
                  <th>Club</th>
                  <th class="fb__num-cell" title="Partidos jugados">PJ</th>
                  <th class="fb__num-cell" title="Ganados">G</th>
                  <th class="fb__num-cell" title="Empatados">E</th>
                  <th class="fb__num-cell" title="Perdidos">P</th>
                  <th class="fb__num-cell" title="Goles a favor">GF</th>
                  <th class="fb__num-cell" title="Goles en contra">GC</th>
                  <th class="fb__num-cell" title="Diferencia de gol">DG</th>
                  <th class="fb__num-cell" title="Puntos">Pts</th>
                </tr>
              </thead>
              <tbody>${body}</tbody>
            </table>
          </figure>
        `;
      })
      .join("");
  }

  function scores(f: Record<string, unknown>): string {
    if (String(f.status) === "Por jugar") {
      return `<span class="fb__vs">vs</span>`;
    }
    return `<span class="fb__score">${esc(f.homeGoals)}<span class="fb__score-sep">–</span>${esc(f.awayGoals)}</span>`;
  }

  function renderFixtures(fixtures: Array<Record<string, unknown>>): string {
    if (fixtures.length === 0) {
      return `<div class="fb__empty">No hay partidos para mostrar en esta sección.</div>`;
    }
    return fixtures
      .map(
        (f) => {
          // Cards with an ESPN event id link to the internal match page;
          // matches without one (edge cases) fall back to a plain article.
          const id = String(f.id ?? "");
          const open = id
            ? `<a class="fb__match${String(f.state) === "in" ? " fb__match--live" : ""}" href="/match/${encodeURIComponent(id)}/">`
            : `<article class="fb__match${String(f.state) === "in" ? " fb__match--live" : ""}">`;
          const close = id ? "</a>" : "</article>";
          return `
          ${open}
            <header class="fb__match-head">
              <span>${esc(f.round)}</span>
              <span class="fb__status${String(f.state) === "in" ? " fb__status--live" : ""}">${statusLabel(String(f.status))}${String(f.state) === "in" && f.elapsed ? ` · ${esc(f.elapsed)}` : ""}</span>
            </header>
            <div class="fb__match-body">
              <span class="fb__club">${clubMarkup(String(f.home), String(f.homeLogo), "left")}</span>
              ${scores(f)}
              <span class="fb__club fb__club--away">${clubMarkup(String(f.away), String(f.awayLogo), "right")}</span>
            </div>
            <footer class="fb__match-foot">
              <span>${fmtDate(String(f.dateUtc))}</span>
              ${f.venue ? `<span>${esc(f.venue)}</span>` : ""}
            </footer>
          ${close}
        `;
        }
      )
      .join("");
  }

  function renderLive(matches: Array<Record<string, unknown>>): string {
    if (matches.length === 0) {
      return `<div class="fb__empty">No hay partidos en vivo en este momento.</div>`;
    }
    return renderFixtures(matches);
  }

  async function load(view: string) {
    if (activeTab === view || inFlight) return;
    activeTab = view;
    tabs.forEach((tab) =>
      tab.setAttribute("aria-selected", tab.dataset.view === view ? "true" : "false")
    );
    setLoading();

    const cached = cacheGet(`${endpoint}:${view}`);
    if (cached) {
      setHtml(cached);
      return;
    }

    inFlight = true;
    try {
      const res = await fetch(`/api/football?competition=${encodeURIComponent(endpoint)}&view=${encodeURIComponent(view)}`);
      if (!res.ok) throw new Error(`API ${res.status}`);
      const payload = await res.json();

      let html: string;
      if (view === "standings") html = renderStandings(payload.groups ?? []);
      else if (view === "live") html = renderLive(payload.fixtures ?? []);
      else html = renderFixtures(payload.fixtures ?? []);

      cacheSet(`${endpoint}:${view}`, html);
      setHtml(html);
    } catch {
      if (activeTab === view) setError();
    } finally {
      inFlight = false;
    }
  }

  tabs.forEach((tab) =>
    tab.addEventListener("click", () => load(tab.dataset.view!))
  );

  // Load the default view with fresh data on every visit.
  activeTab = null;
  load("standings");
</script>

<style is:global>
  .fb__comp-logo {
    height: 48px;
    width: auto;
    object-fit: contain;
    /* Competition marks can be dark artwork; a light chip keeps them visible */
    background: rgb(255 255 255 / 8%);
    border-radius: var(--radius-md);
    padding: 6px;
  }

  /* ----- Tabs ----- */
  .fb__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-4);
  }

  .fb__tab {
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    font: inherit;
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: color var(--ease), border-color var(--ease);
  }

  .fb__tab:hover {
    color: var(--color-text);
  }

  .fb__tab[aria-selected="true"] {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  /* ----- Loading / errors / empty ----- */
  .fb__loading {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--space-5);
  }

  .fb__error,
  .fb__empty {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--space-5);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
  }

  /* ----- Standings ----- */
  .fb__group-title {
    font-size: var(--text-md);
    margin: var(--space-4) 0 var(--space-2);
    color: var(--color-text);
  }

  .fb__table-wrap {
    margin: 0 0 var(--space-3);
    overflow-x: auto;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .fb table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .fb thead th {
    color: var(--color-text-muted);
    font-weight: 700;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-raised);
  }

  .fb tbody td {
    padding: var(--space-2);
    border-bottom: 1px solid rgb(37 57 45 / 80%);
    white-space: nowrap;
  }

  .fb tbody tr:last-child td {
    border-bottom: none;
  }

  .fb tbody tr:nth-child(even) {
    background: rgb(22 39 30 / 55%);
  }

  .fb tbody tr:hover {
    background: rgb(182 240 74 / 8%);
  }

  .fb__num-cell {
    text-align: right;
    width: 2.5rem;
    font-variant-numeric: tabular-nums;
  }

  .fb__club-cell {
    font-weight: 600;
  }

  .fb__club-cell span {
    display: inline-block;
    margin-left: var(--space-2);
  }

  .fb__dim {
    color: var(--color-text-muted);
  }

  .fb__pts {
    font-weight: 800;
    color: var(--color-accent);
    font-size: var(--text-md);
  }

  .fb__table-logo {
    display: inline-block;
    width: 22px;
    height: 22px;
    object-fit: contain;
    vertical-align: middle;
  }

  .fb__club-logo--placeholder {
    background: var(--color-border);
    border-radius: 50%;
  }

  /* ----- Match cards ----- */
  .fb__match {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-2);
    box-shadow: 0 6px 18px rgb(2 10 6 / 35%);
  }

  /* Anchor cards are full-card links: keep the card look, add a hover cue */
  a.fb__match {
    text-decoration: none;
    color: inherit;
    transition: border-color var(--ease), transform var(--ease);
  }

  a.fb__match:hover {
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  .fb__match--live {
    border-color: rgb(58 208 122 / 55%);
  }

  .fb__match-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .fb__match-head span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .fb__status {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    flex-shrink: 0;
  }

  .fb__status--live {
    color: var(--color-success);
  }

  .fb__match-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-2);
  }

  .fb__club {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    min-width: 0;
  }

  .fb__club span:not(.fb__score) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .fb__club--away {
    justify-content: flex-end;
    text-align: right;
  }

  .fb__club-logo {
    width: 26px;
    height: 26px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .fb__score {
    font-weight: 800;
    font-size: var(--text-md);
    text-align: center;
    padding-inline: var(--space-2);
    font-variant-numeric: tabular-nums;
  }

  .fb__score-sep {
    color: var(--color-text-muted);
    padding-inline: 2px;
  }

  .fb__vs {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .fb__match-foot {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }
</style>
