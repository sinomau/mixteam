---
// Data-driven sports view shared by the three competition pages.
// Tabs render standings, results, upcoming fixtures and live matches.
// All data flows through the /api/football server proxy — no API keys
// ever reach the browser. Legacy reference: legacy/js/api.js
interface Props {
  heading: string;
  logo: string;
  logoAlt: string;
  endpoint: string;
}

const { heading, logo, logoAlt, endpoint } = Astro.props;
---

<section class="fb" data-endpoint={endpoint} aria-labelledby="fb-heading">
  <div class="section-title">
    <h2 id="fb-heading">{heading}</h2>
    <img src={logo} alt={logoAlt} loading="eager" />
  </div>

  <div class="fb__tabs" role="tablist" aria-label="Qué ver">
    <button class="fb__tab" role="tab" data-view="standings" aria-selected="true">
      Tabla de posiciones
    </button>
    <button class="fb__tab" role="tab" data-view="last" aria-selected="false">
      Resultados
    </button>
    <button class="fb__tab" role="tab" data-view="next" aria-selected="false">
      Próximos partidos
    </button>
    <button class="fb__tab" role="tab" data-view="live" aria-selected="false">
      En vivo
    </button>
  </div>

  <div class="fb__panel" aria-live="polite"></div>
</section>

<script>
  const section = document.querySelector<HTMLElement>(".fb")!;
  const endpoint = section.dataset.endpoint!;
  const tabs = [...section.querySelectorAll<HTMLButtonElement>(".fb__tab")];
  const panel = section.querySelector<HTMLDivElement>(".fb__panel")!;

  const CACHE_TTL_MS = 5 * 60 * 1000;
  const cache = new Map<string, { html: string; at: number }>();
  let activeTab: string | null = null;
  let inFlight = false;

  const spinner = `<div class="fb__loading" role="status">Cargando…</div>`;
  const errorMessage = `
    <div class="fb__error">
      <p>El contenido no está disponible en este momento.</p>
      <p><button class="btn btn--ghost" onclick="location.reload()">Reintentar</button></p>
    </div>
  `;

  function setLoading() {
    panel.innerHTML = spinner;
  }

  function setError() {
    panel.innerHTML = errorMessage;
  }

  function setHtml(html: string) {
    panel.innerHTML = html;
  }

  function cacheSet(key: string, html: string) {
    cache.set(key, { html, at: Date.now() });
  }

  function cacheGet(key: string): string | null {
    const cached = cache.get(key);
    if (cached && Date.now() - cached.at < CACHE_TTL_MS) return cached.html;
    return null;
  }

  function esc(value: unknown): string {
    return String(value ?? "").replace(/[&<>"']/g, (ch) =>
      ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      })[ch]!
    );
  }

  function statusLabel(status: string): string {
    const labels: Record<string, string> = {
      "First Half": "Primer tiempo",
      "Second Half": "Segundo tiempo",
      Halftime: "Entretiempo",
      "Match Finished": "Terminado",
      "Not Started": "Por jugar",
    };
    return labels[status] ?? status;
  }

  function renderStandings(groups: Array<{ groupName: string; rows: Array<Record<string, unknown>> }>): string {
    return groups
      .map(({ groupName, rows }) => {
        const body = rows
          .map(
            (r) => `
            <tr>
              <td>${esc(r.rank)}</td>
              <td><img class="fb__logo" src="${esc(r.logo)}" alt="" width="22" height="22" loading="lazy"></td>
              <td>${esc(r.team)}</td>
              <td>${esc(r.played)}</td>
              <td>${esc(r.win)}</td>
              <td>${esc(r.draw)}</td>
              <td>${esc(r.lose)}</td>
              <td>${esc(r.goalsFor)}</td>
              <td>${esc(r.goalsAgainst)}</td>
              <td>${esc(r.diff)}</td>
              <td class="fb__pts">${esc(r.points)}</td>
            </tr>
          `
          )
          .join("");
        return `
          <h3 class="fb__group-title">${esc(groupName)}</h3>
          <figure class="fb__table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Pos</th>
                  <th></th>
                  <th>Club</th>
                  <th>PJ</th><th>G</th><th>E</th><th>P</th>
                  <th>GF</th><th>GC</th><th>DG</th><th>Pts</th>
                </tr>
              </thead>
              <tbody>${body}</tbody>
            </table>
          </figure>
        `;
      })
      .join("");
  }

  function renderFixtures(fixtures: Array<Record<string, unknown>>): string {
    if (fixtures.length === 0) {
      return `<div class="fb__empty">No hay partidos para mostrar en esta sección.</div>`;
    }
    return fixtures
      .map((f) => {
        const round = esc(f.round);
        const status = esc(f.status);
        return `
          <article class="fb__match">
            <header class="fb__match-head">
              <span>${round}</span>
              <span class="fb__status">${status}</span>
            </header>
            <div class="fb__match-body">
              <span class="fb__club"><img src="${esc(f.homeLogo)}" alt="" width="24" height="24" loading="lazy"> ${esc(f.home)}</span>
              <span class="fb__score">${goals(f.homeGoals, f.awayGoals, String(f.status))} </span>
              <span class="fb__club">${esc(f.away)} <img src="${esc(f.awayLogo)}" alt="" width="24" height="24" loading="lazy"></span>
            </div>
            <footer class="fb__match-foot">
              <span>${fmtDate(String(f.dateUtc))}</span>
              <span>${esc(f.venue)}</span>
            </footer>
          </article>
        `;
      })
      .join("");
  }

  function fmtDate(iso: string): string {
    return new Date(iso).toLocaleString("es-AR", {
      day: "2-digit",
      month: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  function goals(home: unknown, away: unknown, status: string): string {
    if (status === "Por jugar") return "vs";
    return `${esc(home)} – ${esc(away)}`;
  }

  function renderLive(matches: Array<Record<string, unknown>>): string {
    if (matches.length === 0) {
      return `<div class="fb__empty">No hay partidos en vivo en este momento.</div>`;
    }
    return matches
      .map(
        (m) => `
        <article class="fb__match fb__match--live">
          <header class="fb__match-head">
            <span>${esc(m.league)}</span>
            <span class="fb__status fb__status--live">${esc(m.elapsed)} · ${statusLabel(String(m.status))}</span>
          </header>
          <div class="fb__match-body">
            <span class="fb__club"><img src="${esc(m.homeLogo)}" alt="" width="24" height="24">${esc(m.home)}</span>
            <span class="fb__score">${esc(m.homeGoals)} – ${esc(m.awayGoals)}</span>
            <span class="fb__club">${esc(m.away)}<img src="${esc(m.awayLogo)}" alt="" width="24" height="24"></span>
          </div>
        </article>
      `
      )
      .join("");
  }

  async function load(view: string) {
    if (activeTab === view || inFlight) return;
    activeTab = view;
    tabs.forEach((tab) =>
      tab.setAttribute("aria-selected", tab.dataset.view === view ? "true" : "false")
    );
    setLoading();

    const cached = cacheGet(`${endpoint}:${view}`);
    if (cached) {
      setHtml(cached);
      return;
    }

    inFlight = true;
    try {
      const res = await fetch(`/api/football?competition=${encodeURIComponent(endpoint)}&view=${encodeURIComponent(view)}`);
      if (!res.ok) throw new Error(`API ${res.status}`);
      const payload = await res.json();

      let html: string;
      if (view === "standings") html = renderStandings(payload.groups ?? []);
      else if (view === "live") html = renderLive(payload.fixtures ?? []);
      else html = renderFixtures(payload.fixtures ?? []);

      cacheSet(`${endpoint}:${view}`, html);
      setHtml(html);
    } catch {
      if (activeTab === view) setError();
    } finally {
      inFlight = false;
      if (activeTab === view) {
        // allow re-click on the same tab if the user wants to retry manually
      }
    }
  }

  tabs.forEach((tab) =>
    tab.addEventListener("click", () => load(tab.dataset.view!))
  );

  // Load the default view with fresh data on every visit.
  activeTab = null;
  load("standings");
</script>

<style>
  .fb__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-4);
  }

  .fb__tab {
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    font: inherit;
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: color var(--ease), border-color var(--ease);
  }

  .fb__tab:hover {
    color: var(--color-text);
  }

  .fb__tab[aria-selected="true"] {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .fb__loading {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--space-5);
  }

  .fb__error,
  .fb__empty {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--space-5);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
  }

  .fb__group-title {
    font-size: var(--text-md);
    margin-block: var(--space-4) var(--space-2);
  }

  .fb__table-wrap {
    margin: 0 0 var(--space-4);
    overflow-x: auto;
  }

  .fb table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .fb th,
  .fb td {
    text-align: left;
    padding: var(--space-2) var(--space-2);
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
  }

  .fb th {
    color: var(--color-text-muted);
    font-weight: 600;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .fb__logo,
  .fb .fb__club img {
    display: inline-block;
    vertical-align: middle;
  }

  .fb__pts {
    font-weight: 700;
    color: var(--color-accent);
  }

  .fb__match {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .fb__match--live {
    border-color: var(--color-accent);
  }

  .fb__match-head {
    display: flex;
    justify-content: space-between;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .fb__match-body {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-2);
  }

  .fb__club {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
  }

  .fb__club:last-child {
    justify-content: flex-start;
  }

  .fb__score {
    font-weight: 700;
    text-align: center;
  }

  .fb .fb__match-foot {
    display: flex;
    justify-content: space-between;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .fb .fb__match-foot {
    flex-wrap: wrap;
  }

  .fb__status {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .fb__status--live {
    color: var(--color-success);
    font-weight: 700;
  }

  .fb .fb__club img {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }
</style>
