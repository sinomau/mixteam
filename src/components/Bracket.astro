---
// Knockout bracket ("Llaves") for the cup pages: every round of the current
// edition in order, each tie with its legs, aggregate result, penalties and
// the team that advanced. Data comes from the /api/bracket server proxy —
// no API keys ever reach the browser.
interface Props {
  competition: string;
  heading: string;
}

const { competition, heading } = Astro.props;
---

<section class="br" data-competition={competition} aria-labelledby="br-heading">
  <div class="br__section-title">
    <h2 id="br-heading">{heading}</h2>
  </div>

  <div class="br__card">
    <p class="br__eyebrow">Llaves</p>
    <div class="br__panel" aria-live="polite"></div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>(".br")!;
  const competition = section.dataset.competition!;
  const panel = section.querySelector<HTMLDivElement>(".br__panel")!;

  const CACHE_TTL_MS = 5 * 60 * 1000;
  const EMPTY_MESSAGE = "Aún no hay rutas definidas para esta etapa del torneo.";

  const cache = new Map<string, { html: string; at: number }>();
  let inFlight = false;

  function esc(value: unknown): string {
    return String(value ?? "").replace(/[&<>"']/g, (ch) =>
      ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      })[ch]!
    );
  }

  function clubFromLeg(leg: Record<string, unknown>, side: "home" | "away") {
    return {
      id: String(leg[`${side}Id`] ?? ""),
      name: String(leg[side] ?? ""),
      logo: String(leg[`${side}Logo`] ?? ""),
    };
  }

  // A completed tie has every leg played. In a pending tie only the last leg
  // (in date order) is still to come; a live leg counts as being played. The
  // leg's own status wins when the payload exposes it.
  function isPlayedLeg(
    tie: Record<string, unknown>,
    legs: Array<Record<string, unknown>>,
    index: number
  ): boolean {
    const leg = legs[index];
    const legStatus = String(leg.status ?? "");
    if (leg.live === true || legStatus === "live") return true;
    if (legStatus === "completed") return true;
    if (legStatus === "pending") return false;
    if (String(tie.status ?? "") === "completed") return true;
    return index < legs.length - 1;
  }

  // Goals per tie side, following each leg's own home/away order so a club
  // that swapped venues still gets its goals credited on the right side.
  function goalsBySide(
    legs: Array<Record<string, unknown>>,
    awayClubId: string
  ): { home: number; away: number } {
    const result = { home: 0, away: 0 };
    legs.forEach((leg) => {
      const homeGoals = Number(leg.homeScore);
      const awayGoals = Number(leg.awayScore);
      if (!Number.isFinite(homeGoals) || !Number.isFinite(awayGoals)) return;
      const legHomeId = String(leg.homeId ?? "");
      if (legHomeId !== "" && legHomeId === awayClubId) {
        result.home += awayGoals;
        result.away += homeGoals;
        return;
      }
      result.home += homeGoals;
      result.away += awayGoals;
    });
    return result;
  }

  // Shoot-out digits, aligned to the same sides as goalsBySide().
  function pensBySide(
    legs: Array<Record<string, unknown>>,
    awayClubId: string
  ): { home: string; away: string } | null {
    for (const leg of legs) {
      const pensHome = String(leg.pensHome ?? "").trim();
      const pensAway = String(leg.pensAway ?? "").trim();
      if (pensHome === "" || pensAway === "") continue;
      const legHomeId = String(leg.homeId ?? "");
      return legHomeId !== "" && legHomeId === awayClubId
        ? { home: pensAway, away: pensHome }
        : { home: pensHome, away: pensAway };
    }
    return null;
  }

  // ----- The tie, read once and shared by both views -----
  //
  // The poster card and the mobile list print the same numbers: each club's
  // goals summed across both legs (venue swaps included), the shoot-out digits
  // in parentheses, the dates of each leg and, on the final, the stadium.

  interface TieClub {
    id: string;
    name: string;
    logo: string;
  }

  interface TieParts {
    legs: Array<Record<string, unknown>>;
    homeClub: TieClub;
    awayClub: TieClub;
    completed: boolean;
    live: boolean;
    played: boolean;
    aggregate: { home: number; away: number };
    pens: { home: string; away: string } | null;
    homeIsWinner: boolean;
    awayIsWinner: boolean;
    dates: string;
    venue: string;
  }

  function tieParts(tie: Record<string, unknown>): TieParts {
    const legs = (Array.isArray(tie.legs) ? tie.legs : []) as Array<Record<string, unknown>>;
    const first = legs[0] ?? {};
    const homeClub = clubFromLeg(first, "home");
    const awayClub = clubFromLeg(first, "away");

    const completed = String(tie.status ?? "") === "completed";
    const live = legs.some((leg) => leg.live === true);

    const playedLegs: Array<Record<string, unknown>> = [];
    legs.forEach((leg, index) => {
      if (isPlayedLeg(tie, legs, index)) playedLegs.push(leg);
    });
    const played = playedLegs.length > 0;

    const aggregate = goalsBySide(playedLegs, awayClub.id);
    const pens = played ? pensBySide(playedLegs, awayClub.id) : null;
    const winnerId = completed ? String(tie.winnerId ?? "") : "";

    // Only the one-off final has a stadium that belongs to the tie itself; on a
    // two-legged round it is just the ground of one match.
    const venue =
      legs.map((leg) => String(leg.venue ?? "").trim()).find((value) => value !== "") ?? "";

    return {
      legs,
      homeClub,
      awayClub,
      completed,
      live,
      played,
      aggregate,
      pens,
      homeIsWinner: winnerId !== "" && winnerId === homeClub.id,
      awayIsWinner: winnerId !== "" && winnerId === awayClub.id,
      dates: tieDates(tie),
      venue,
    };
  }

  /** One club line, shared by the poster card and the mobile card. */
  function clubScoreRow(club: TieClub, parts: TieParts, side: "home" | "away"): string {
    const isWinner = side === "home" ? parts.homeIsWinner : parts.awayIsWinner;
    const decided = parts.homeIsWinner || parts.awayIsWinner;
    const isLoser = decided && !isWinner;

    const name = club.name || "Por definir";
    const logo = club.logo
      ? `<img class="br__row-logo" src="${esc(club.logo)}" alt="" width="16" height="16" loading="lazy">`
      : `<span class="br__row-logo br__row-logo--placeholder" aria-hidden="true"></span>`;

    const classes = ["br__row"];
    if (isWinner) classes.push("br__row--winner");
    if (isLoser) classes.push("br__row--loser");

    const goals = side === "home" ? parts.aggregate.home : parts.aggregate.away;
    const pensDigit = side === "home" ? (parts.pens?.home ?? "") : (parts.pens?.away ?? "");
    // Parentheses keep the shoot-out from reading as a second digit of the
    // aggregate ("1 6" vs "1 (6)").
    const score = parts.played
      ? `<span class="br__row-score">${goals}${
          pensDigit ? `<small>(${esc(pensDigit)})</small>` : ""
        }</span>`
      : "";
    // The tick column is always there, empty or not, so both clubs' scores line
    // up instead of shifting when one of them has advanced.
    const badge = isWinner
      ? `<span class="br__winner" role="img" aria-label="Clasificado" title="Clasificado">✓</span>`
      : `<span class="br__winner" aria-hidden="true"></span>`;

    return `
        <div class="${classes.join(" ")}">
          ${logo}
          <span class="br__row-name" title="${esc(name)}">${esc(name)}</span>
          ${score}
          ${badge}
        </div>`;
  }

  /**
   * One card of the mobile list: the same compact shape the poster draws, with
   * the leg dates as its footer. It stays around 60px tall so a full bracket is
   * one short scroll instead of a page of cards.
   */
  function tieMarkup(tie: Record<string, unknown>, final: boolean): string {
    const parts = tieParts(tie);
    if (parts.legs.length === 0) return "";

    const classes = ["br__tie"];
    classes.push(parts.completed ? "br__tie--completed" : "br__tie--pending");
    if (parts.live) classes.push("br__tie--live");

    const footParts: string[] = [];
    if (parts.live) {
      footParts.push(
        `<span class="br__live"><span class="br__live-dot" aria-hidden="true"></span>En vivo</span>`
      );
    }
    if (parts.dates) {
      footParts.push(`<span class="br__tie-dates">${esc(parts.dates)}</span>`);
    }
    const foot = footParts.length ? `<p class="br__foot">${footParts.join("")}</p>` : "";
    const venue = final && parts.venue ? `<p class="br__venue">${esc(parts.venue)}</p>` : "";

    return `
      <article class="${classes.join(" ")}">
        <div class="br__clubs">
          ${clubScoreRow(parts.homeClub, parts, "home")}
          ${clubScoreRow(parts.awayClub, parts, "away")}
        </div>
        ${foot}
        ${venue}
      </article>
    `;
  }

  function renderBracket(payload: Record<string, unknown>): string {
    const rounds = Array.isArray(payload.rounds)
      ? (payload.rounds as Array<Record<string, unknown>>)
      : [];

    const visible = rounds
      .map((round) => {
        const ties = Array.isArray(round.ties)
          ? (round.ties as Array<Record<string, unknown>>)
          : [];
        return { title: String(round.title ?? ""), ties };
      })
      .filter((round) => round.ties.length > 0);

    if (visible.length === 0) {
      return `<div class="br__empty">${EMPTY_MESSAGE}</div>`;
    }

    // The last round is the final when it holds a single tie: only that card
    // gets the stadium, exactly like the poster.
    const isFinal = (index: number) =>
      index === visible.length - 1 && visible[index].ties.length === 1;

    // Each stage is its own block: on a phone the list opens on the rounds that
    // are still being played and keeps the finished ones one tap away. When the
    // edition is over, the last two stay open for context.
    const pending = visible.map((round) =>
      round.ties.some((tie) => String(tie.status ?? "") !== "completed")
    );
    const anyPending = pending.some(Boolean);
    const openAt = (index: number) =>
      anyPending ? pending[index] : index >= visible.length - 2;

    const roundHtml = (round: { title: string; ties: Array<Record<string, unknown>> }, index: number) => `
        <details class="br__round"${openAt(index) ? " open" : ""}>
          <summary class="br__round-title"><span class="br__round-name">${esc(
            round.title
          )}</span><span class="br__round-count">${round.ties.length}</span></summary>
          <div class="br__ties">${round.ties
            .map((tie) => tieMarkup(tie, isFinal(index)))
            .join("")}</div>
        </details>
      `;

    const columns = visible.map((round, index) => roundHtml(round, index)).join("");

    // The tree is the desktop view; the stacked rounds stay for mobile. When
    // the rounds do not form a tree (a tournament without a final yet), the
    // stacked list is the only view there is.
    const tree = buildTree(rounds);
    const listClass = tree ? "br__rounds br__rounds--tree" : "br__rounds";

    return `<div class="${listClass}">${columns}</div>${
      tree ? renderTree(tree) : ""
    }`;
  }

  // ----- The bracket as a connected tree -----
  //
  // The rounds are a tree: the tie that produced a club is the tie that fed
  // it. The diagram draws that link, puts the final in the middle and mirrors
  // its two branches around it, the way a tournament poster does. The leg
  // scores sit on the line that leaves each tie, where the poster puts them.

  const TREE = {
    cardW: 172,
    cardH: 58,
    gap: 34,
    row: 68,
    pad: 10,
    header: 22,
    /** Most first-round ties the poster draws (8 = the classic 16-team shape). */
    maxSlots: 8,
  };

  interface TreeBox {
    id: string;
    tie: Record<string, unknown>;
    roundIndex: number;
    branch: "left" | "right" | "center";
    column: number;
    x: number;
    centerY: number;
    isRoot: boolean;
  }

  function treeParents(tie: Record<string, unknown>): { home: string; away: string } {
    const parents = (tie.parents ?? {}) as Record<string, unknown>;
    return { home: String(parents.home ?? ""), away: String(parents.away ?? "") };
  }

  /** Day/month of a leg, plus the kick-off time while the leg is unplayed. */
  function legDate(leg: Record<string, unknown>): string {
    const date = new Date(String(leg.dateUtc ?? ""));
    if (Number.isNaN(date.getTime())) return "";
    const day = `${String(date.getDate()).padStart(2, "0")}/${String(
      date.getMonth() + 1
    ).padStart(2, "0")}`;
    if (leg.live === true || String(leg.status ?? "") !== "pending") return day;
    const time = `${String(date.getHours()).padStart(2, "0")}:${String(
      date.getMinutes()
    ).padStart(2, "0")}`;
    return `${day} ${time}`;
  }

  /** "IDA 24/04 · VUELTA 08/05" — the line the poster prints under the clubs. */
  function tieDates(tie: Record<string, unknown>): string {
    const legs = (Array.isArray(tie.legs) ? tie.legs : []) as Array<Record<string, unknown>>;
    return legs
      .map((leg) => {
        const label = String(leg.legLabel ?? "").trim().toUpperCase();
        const date = legDate(leg);
        return [label, date].filter(Boolean).join(" ");
      })
      .filter(Boolean)
      .join(" · ");
  }

  /**
   * Lays the rounds out as a tree.
   *
   * Every tie owns a vertical range of the canvas: a side that was fed by
   * another tie owns that tie's whole range, a side whose club entered the
   * round directly owns nothing (there is no card to draw for it — the tie
   * card already names both clubs). A tie sits in the middle of the two
   * sides it was fed by, so a tie with one feeder stays aligned with it and
   * a tie with two feeders sits between them: the classic poster shape.
   */
  function buildTree(rounds: Array<Record<string, unknown>>) {
    const list = rounds
      .map((round) => ({
        title: String(round.title ?? ""),
        ties: (Array.isArray(round.ties) ? round.ties : []) as Array<Record<string, unknown>>,
      }))
      .filter((round) => round.ties.length > 0);
    if (list.length < 2) return null;

    // The poster is built around ONE final. A stage whose last round still has
    // several ties (a cup before its final is drawn) keeps the stacked view
    // instead of silently dropping half of the bracket.
    if (list[list.length - 1].ties.length !== 1) return null;

    const byId = new Map<string, { tie: Record<string, unknown>; roundIndex: number }>();
    list.forEach((round, roundIndex) => {
      for (const tie of round.ties) {
        const id = String(tie.id ?? "");
        if (id && !byId.has(id)) byId.set(id, { tie, roundIndex });
      }
    });

    const rootTie = list[list.length - 1].ties[0];
    const rootId = String(rootTie.id ?? "");
    if (!byId.has(rootId)) return null;

    const rootParents = treeParents(rootTie);
    // The poster needs one final with a branch on each side.
    if (!rootParents.home || !rootParents.away) return null;

    const spanCache = new Map<string, number>();
    const spanOf = (id: string): number => {
      const cached = spanCache.get(id);
      if (cached !== undefined) return cached;
      const entry = byId.get(id);
      if (!entry) return 1;
      const parents = treeParents(entry.tie);
      let span = 1;
      if (entry.roundIndex > 0) {
        const home = parents.home ? spanOf(parents.home) : 0;
        const away = parents.away ? spanOf(parents.away) : 0;
        span = home + away;
      }
      if (span === 0) span = 1;
      spanCache.set(id, span);
      return span;
    };

    const totalSlots = spanOf(rootParents.home) + spanOf(rootParents.away);
    // The poster draws the home stretch. A 64-team cup has seven rounds, and a
    // full tree would stand thousands of pixels tall inside the card, so the
    // outermost round is dropped until the shape fits; the list view (mobile)
    // still carries every round.
    if (totalSlots > TREE.maxSlots && list.length > 2) {
      return buildTree(list.slice(1));
    }

    const centers = new Map<string, number>();
    const place = (id: string, startSlot: number): void => {
      const entry = byId.get(id);
      if (!entry) return;
      const parents = treeParents(entry.tie);
      if (entry.roundIndex === 0) {
        centers.set(id, startSlot + 0.5);
        return;
      }
      const homeSpan = parents.home ? spanOf(parents.home) : 0;
      if (parents.home) place(parents.home, startSlot);
      if (parents.away) place(parents.away, startSlot + homeSpan);
      const homeCenter = parents.home ? centers.get(parents.home) : undefined;
      const awayCenter = parents.away ? centers.get(parents.away) : undefined;
      // A tie fed by one side only keeps that side's line; fed by two, it
      // sits in the middle of both.
      const center =
        homeCenter !== undefined && awayCenter !== undefined
          ? (homeCenter + awayCenter) / 2
          : homeCenter !== undefined
            ? homeCenter
            : awayCenter !== undefined
              ? awayCenter
              : startSlot + 0.5;
      centers.set(id, center);
    };

    place(rootId, 0);

    const depth = list.length - 1;

    const branchOf = new Map<string, "left" | "right">();
    const walk = (id: string, branch: "left" | "right") => {
      if (branchOf.has(id)) return;
      branchOf.set(id, branch);
      const entry = byId.get(id);
      if (!entry) return;
      const parents = treeParents(entry.tie);
      if (parents.home) walk(parents.home, branch);
      if (parents.away) walk(parents.away, branch);
    };
    walk(rootParents.home, "left");
    walk(rootParents.away, "right");

    const columnX = (column: number) => TREE.pad + column * (TREE.cardW + TREE.gap);
    const boxes: TreeBox[] = [];

    for (const [id, entry] of byId) {
      const branch = branchOf.get(id);
      if (!branch) continue;
      const column = branch === "left" ? entry.roundIndex : 2 * depth - entry.roundIndex;
      boxes.push({
        id,
        tie: entry.tie,
        roundIndex: entry.roundIndex,
        branch,
        column,
        x: columnX(column),
        centerY: TREE.header + (centers.get(id) ?? 0) * TREE.row,
        isRoot: false,
      });
    }

    boxes.push({
      id: rootId,
      tie: rootTie,
      roundIndex: depth,
      branch: "center",
      column: depth,
      x: columnX(depth),
      centerY: TREE.header + (totalSlots / 2) * TREE.row,
      isRoot: true,
    });

    const byBoxId = new Map(boxes.map((box) => [box.id, box]));

    const titles: Array<{ x: number; text: string }> = [];
    for (const box of boxes) {
      if (titles.some((title) => title.x === box.x)) continue;
      titles.push({ x: box.x, text: list[box.roundIndex]?.title ?? "" });
    }
    titles.sort((a, b) => a.x - b.x);

    const paths: string[] = [];

    // Every tie joins the tie it produced: the feeder draws the horizontal
    // stub and the vertical at the tie's inner edge, and the vertical ends on
    // the tie's own line, so the two feeders of a tie share one vertical the
    // way a poster draws it.
    for (const parent of boxes) {
      if (parent.isRoot) continue;
      const verticalX = parent.branch === "left" ? parent.x : parent.x + TREE.cardW;

      const parents = treeParents(parent.tie);
      for (const side of ["home", "away"] as const) {
        const childId = parents[side];
        if (!childId) continue;
        const child = byBoxId.get(childId);
        if (!child) continue;
        const from = child.branch === "left" ? child.x + TREE.cardW : child.x;
        paths.push(`M ${from} ${child.centerY} H ${verticalX}`);
        paths.push(`M ${verticalX} ${child.centerY} V ${parent.centerY}`);
      }
    }

    // The final: both branches converge into the card in the middle.
    const leftChild = byBoxId.get(rootParents.home);
    const rightChild = byBoxId.get(rootParents.away);
    if (leftChild && rightChild) {
      const leftJoin = rootBoxX(boxes) - 26;
      paths.push(`M ${leftChild.x + TREE.cardW} ${leftChild.centerY} H ${leftJoin}`);
      paths.push(`M ${leftJoin} ${leftChild.centerY} V ${rootBoxY(boxes)}`);
      paths.push(`M ${leftJoin} ${rootBoxY(boxes)} H ${rootBoxX(boxes)}`);

      const rightJoin = rootBoxX(boxes) + TREE.cardW + 26;
      paths.push(`M ${rightChild.x} ${rightChild.centerY} H ${rightJoin}`);
      paths.push(`M ${rightJoin} ${rightChild.centerY} V ${rootBoxY(boxes)}`);
      paths.push(`M ${rootBoxX(boxes) + TREE.cardW} ${rootBoxY(boxes)} H ${rightJoin}`);
    }

    const width = TREE.pad * 2 + (2 * depth + 1) * TREE.cardW + 2 * depth * TREE.gap;
    const height = TREE.header + totalSlots * TREE.row + TREE.pad;

    return { boxes, paths, titles, width, height };
  }

  function rootBoxX(boxes: TreeBox[]): number {
    return boxes.find((box) => box.isRoot)?.x ?? 0;
  }

  function rootBoxY(boxes: TreeBox[]): number {
    return boxes.find((box) => box.isRoot)?.centerY ?? 0;
  }

  /**
   * One node of the poster: the two clubs with their aggregate score, the
   * dates of each leg underneath and, on the final only, the host stadium.
   *
   * The aggregate is what "cómo fueron pasando" needs at a glance: each club's
   * goals summed across both legs (venue swaps included), with the shoot-out
   * digits in parentheses when the tie went to penalties.
   */
  function treeCard(box: TreeBox): string {
    const parts = tieParts(box.tie);
    if (parts.legs.length === 0) return "";

    const classes = ["br__node"];
    if (box.isRoot) classes.push("br__node--root");

    const venue = box.isRoot ? parts.venue : "";

    // The final is the tallest card (it also names the stadium): its height
    // grows by one line, still centered on its connector line.
    const height = TREE.cardH + (venue ? 18 : 0);
    const position = `left:${box.x}px;top:${box.centerY - height / 2}px;width:${
      TREE.cardW
    }px;height:${height}px`;

    return `
      <article class="${classes.join(" ")}" style="${position}">
        <div class="br__clubs">
          ${clubScoreRow(parts.homeClub, parts, "home")}
          ${clubScoreRow(parts.awayClub, parts, "away")}
        </div>
        ${parts.dates ? `<p class="br__foot">${esc(parts.dates)}</p>` : ""}
        ${venue ? `<p class="br__venue">${esc(venue)}</p>` : ""}
      </article>
    `;
  }

  function renderTree(tree: ReturnType<typeof buildTree>): string {
    if (!tree) return "";

    const { boxes, paths, titles, width, height } = tree;
    const strokes = paths.map((d) => `<path d="${d}" />`).join("");
    const headers = titles
      .map(
        (title) =>
          `<div class="br__tree-round" style="left:${title.x}px;width:${TREE.cardW}px">${esc(title.text)}</div>`
      )
      .join("");
    const cards = boxes.map(treeCard).join("");

    return `
      <div class="br__tree-scroll">
        <div class="br__tree" style="width:${width}px;height:${height}px">
          <svg class="br__tree-lines" width="${width}" height="${height}" viewBox="0 0 ${width} ${height}" aria-hidden="true" focusable="false">
            <g class="br__tree-strokes">${strokes}</g>
          </svg>
          ${headers}
          ${cards}
        </div>
      </div>
    `;
  }

  function setLoading() {
    panel.innerHTML = `<div class="br__loading" role="status"><span class="br__spinner" aria-hidden="true"></span>Cargando…</div>`;
  }

  function setError() {
    panel.innerHTML = `
      <div class="br__error">
        <p>No pudimos cargar las llaves en este momento.</p>
        <p><button class="btn btn--ghost br__retry" type="button">Reintentar</button></p>
      </div>
    `;
    panel.querySelector(".br__retry")?.addEventListener("click", () => {
      cache.delete(competition);
      load(true);
    });
  }

  // The tree is wider than the screen: open it on the final, the node the
  // diagram is built around, and let the rounds scroll out from there.
  function centerTree(): void {
    const scroller = panel.querySelector<HTMLElement>(".br__tree-scroll");
    if (!scroller) return;
    scroller.scrollLeft = Math.max(0, (scroller.scrollWidth - scroller.clientWidth) / 2);
  }

  // The accordion is a phone shape. When the rounds themselves are the desktop
  // view (a cup whose final is still open) every block starts expanded.
  const wideView = window.matchMedia("(min-width: 901px)");

  function expandRoundsOnDesktop(): void {
    if (!wideView.matches) return;
    if (panel.querySelector(".br__tree")) return;
    panel.querySelectorAll<HTMLDetailsElement>(".br__round").forEach((round) => {
      round.open = true;
    });
  }

  wideView.addEventListener("change", expandRoundsOnDesktop);

  function mount(html: string): void {
    panel.innerHTML = html;
    centerTree();
    expandRoundsOnDesktop();
  }

  async function load(force = false) {
    if (inFlight) return;

    if (!force) {
      const cached = cache.get(competition);
      if (cached && Date.now() - cached.at < CACHE_TTL_MS) {
        mount(cached.html);
        return;
      }
    }

    inFlight = true;
    setLoading();

    try {
      const res = await fetch(
        `/api/bracket?competition=${encodeURIComponent(competition)}`
      );
      if (!res.ok) throw new Error(`API ${res.status}`);
      const payload = await res.json();
      const html = renderBracket(payload);
      cache.set(competition, { html, at: Date.now() });
      mount(html);
    } catch {
      setError();
    } finally {
      inFlight = false;
    }
  }

  load();
</script>

