---
// Match detail, ESPN-gamecast style: score header, summary of goals and
// cards, stats and lineups. Rendered server-side (SEO + first paint) and
// kept alive by polling /api/match every 60s while the match is on.
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  fetchMatchDetail,
  isValidEventId,
  eventsHtml,
  statsHtml,
  halvesHtml,
} from "../../lib/matchDetail";

export const prerender = false;

const id = Astro.params.id ?? "";
const detail = isValidEventId(id)
  ? await fetchMatchDetail(id).catch(() => null)
  : null;

if (!detail) Astro.response.status = 404;

function fmtDate(iso: string): string {
  if (!iso) return "";
  return new Date(iso).toLocaleString("es-AR", {
    weekday: "short",
    day: "2-digit",
    month: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
  });
}

const title = detail ? `${detail.home.name} vs ${detail.away.name}` : "Partido no encontrado";

const description = !detail
  ? "El detalle del partido no está disponible."
  : detail.status.state === "pre"
    ? `${detail.league} · ${fmtDate(detail.dateUtc)}. ${detail.home.name} vs ${detail.away.name}.`
    : `${detail.league} · ${detail.home.name} ${detail.home.score}-${detail.away.score} ${detail.away.name}. ${detail.status.label}.`;
---

<BaseLayout title={title} description={description}>
  {
    detail ? (
      <article class="mx" data-id={detail.id} data-state={detail.status.state}>
        <header class="mx__head card">
          <p class="mx__league">{detail.league}</p>
          {detail.season && <p class="mx__season">{detail.season}</p>}

          <h1 class="mx__scoreline">
            <span class="mx__team">
              {detail.home.logo ? (
                <img
                  class="mx__logo"
                  src={detail.home.logo}
                  alt=""
                  width="56"
                  height="56"
                />
              ) : (
                <span class="mx__logo mx__logo--empty" aria-hidden="true" />
              )}
              <span class="mx__team-name">{detail.home.name}</span>
              {detail.home.record && <span class="mx__record">{detail.home.record}</span>}
            </span>

            {detail.status.state === "pre" ? (
              <span class="mx__vs">vs</span>
            ) : (
              <span class="mx__score">
                <span data-score="home">{detail.home.score}</span>
                <span class="mx__sep" aria-hidden="true">–</span>
                <span data-score="away">{detail.away.score}</span>
              </span>
            )}

            <span class="mx__team">
              {detail.away.logo ? (
                <img
                  class="mx__logo"
                  src={detail.away.logo}
                  alt=""
                  width="56"
                  height="56"
                />
              ) : (
                <span class="mx__logo mx__logo--empty" aria-hidden="true" />
              )}
              <span class="mx__team-name">{detail.away.name}</span>
              {detail.away.record && <span class="mx__record">{detail.away.record}</span>}
            </span>
          </h1>

          <p class="mx__status">
            {detail.status.live && (
              <span class="mx__dot" data-dot aria-hidden="true" />
            )}
            <span data-status>{detail.status.label}</span>
          </p>

          <div class="mx__halves" data-halves set:html={halvesHtml(detail)} />

          <p class="mx__meta">
            {detail.dateUtc && <span>{fmtDate(detail.dateUtc)}</span>}
            {detail.venue && <span>{detail.venue}</span>}
          </p>
        </header>

        {detail.status.state !== "pre" && (
          <div class="mx__grid">
            <section class="card mx__card" aria-labelledby="mx-events-title">
              <h2 id="mx-events-title">Resumen</h2>
              <div data-events set:html={eventsHtml(detail)} />
            </section>
            <section class="card mx__card" aria-labelledby="mx-stats-title">
              <h2 id="mx-stats-title">Estadísticas</h2>
              <div data-stats set:html={statsHtml(detail)} />
            </section>
          </div>
        )}

        {detail.lineups.length > 0 && (
          <section class="card mx__card" aria-labelledby="mx-lineups-title">
            <h2 id="mx-lineups-title">Alineaciones</h2>
            <div class="mx__lineups">
              {detail.lineups.map((lineup) => (
                <div class="mx__lineup">
                  <p class="mx__lineup-team">{lineup.team}</p>
                  <ul class="mx__lineup-list">
                    {lineup.players.map((player) => (
                      <li class="mx__player">
                        <span class="mx__num">{player.number}</span>
                        <span class="mx__player-name">{player.name}</span>
                        <span class="mx__pos">{player.position}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        )}

      </article>
    ) : (
      <section class="mx mx--error">
        <div class="card">
          <h1>Partido no encontrado</h1>
          <p class="mx__empty">
            No encontramos ese partido: puede que haya finalizado o que el enlace esté
            mal.
          </p>
          <p>
            <a class="btn btn--soft" href="/">
              Volver al inicio
            </a>
          </p>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>(".mx[data-id]");
  if (root) {
    const id = root.dataset.id!;
    const initial = root.dataset.state!;

    const statusEl = root.querySelector<HTMLElement>("[data-status]");
    const dotEl = root.querySelector<HTMLElement>("[data-dot]");
    const homeScoreEl = root.querySelector<HTMLElement>('[data-score="home"]');
    const awayScoreEl = root.querySelector<HTMLElement>('[data-score="away"]');
    const eventsEl = root.querySelector<HTMLElement>("[data-events]");
    const statsEl = root.querySelector<HTMLElement>("[data-stats]");
    const halvesEl = root.querySelector<HTMLElement>("[data-halves]");

    // Scheduled pages poll too, so a pre-game page flips itself to the live
    // board when the whistle blows; finished matches stop the timer.
    if (initial !== "post") {
      let lastEvents = "";
      let lastStats = "";
      let lastHalves = "";

      const timer = window.setInterval(async () => {
        try {
          const res = await fetch(`/api/match?id=${encodeURIComponent(id)}`, {
            headers: { accept: "application/json" },
          });
          if (!res.ok) return;
          const payload = await res.json();
          const detail = payload?.detail;
          const html = payload?.html;
          if (!detail?.status) return;

          if (initial === "pre" && detail.status.state !== "pre") {
            // The layout changes with the whistle (vs becomes numbers and
            // the sections appear): a fresh page is the honest swap.
            window.clearInterval(timer);
            location.reload();
            return;
          }

          if (statusEl) statusEl.textContent = detail.status.label;
          if (dotEl) dotEl.hidden = !detail.status.live;
          if (homeScoreEl) homeScoreEl.textContent = detail.home.score;
          if (awayScoreEl) awayScoreEl.textContent = detail.away.score;

          if (eventsEl && html.events !== lastEvents) {
            eventsEl.innerHTML = html.events;
            lastEvents = html.events;
          }
          if (statsEl && html.stats !== lastStats) {
            statsEl.innerHTML = html.stats;
            lastStats = html.stats;
          }
          if (halvesEl && html.halves !== lastHalves) {
            halvesEl.innerHTML = html.halves;
            lastHalves = html.halves;
          }

          if (detail.status.state === "post") window.clearInterval(timer);
        } catch {
          // The poll is best-effort: a failed minute is simply retried.
        }
      }, 60_000);
    }
  }
</script>

<style>
  .mx {
    display: grid;
    gap: var(--space-3);
  }

  .mx__head {
    display: grid;
    gap: var(--space-2);
    text-align: center;
  }

  .mx__league {
    color: var(--color-accent-soft);
    font-size: var(--text-sm);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .mx__season {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The matchup itself is the h1: teams and score in one line. */
  .mx__scoreline {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    font-size: inherit;
    font-weight: 400;
    letter-spacing: normal;
  }

  .mx__team {
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    min-width: 0;
  }

  .mx__logo {
    width: 56px;
    height: 56px;
    object-fit: contain;
  }

  .mx__logo--empty {
    border: 1px dashed var(--color-border-strong);
    border-radius: 50%;
  }

  .mx__team-name {
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .mx__record {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .mx__score {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: clamp(2.2rem, 1.4rem + 3vw, 3.4rem);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .mx__vs {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .mx__sep {
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .mx__status {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-soft);
  }

  .mx__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-danger);
    animation: mx-pulse 1.4s ease-in-out infinite;
  }

  @keyframes mx-pulse {
    50% {
      opacity: 0.35;
    }
  }

  .mx__halves {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
  }

  .mx__half {
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-soft);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .mx__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.3rem 0.75rem;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .mx__grid {
    display: grid;
    gap: var(--space-3);
  }

  .mx__card h2 {
    margin-bottom: var(--space-3);
    font-size: var(--text-md);
  }

  .mx__events {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mx__event {
    display: grid;
    grid-template-columns: 3.2rem 1.4rem 1fr;
    align-items: start;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .mx__event-clock {
    color: var(--color-text-muted);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-align: right;
    padding-top: 0.1rem;
  }

  .mx__event-body {
    display: grid;
    min-width: 0;
  }

  .mx__event-player {
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .mx__event-assist,
  .mx__event-team {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    overflow-wrap: anywhere;
  }

  .mx__stats {
    display: grid;
    gap: var(--space-2);
  }

  .mx__stat-head,
  .mx__stat {
    display: grid;
    grid-template-columns: 3.5rem 1fr 3.5rem;
    align-items: center;
    gap: var(--space-2);
  }

  .mx__stat-head {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    text-align: center;
  }

  .mx__stat {
    font-size: var(--text-sm);
  }

  .mx__stat-value {
    text-align: center;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .mx__stat-label {
    display: grid;
    gap: 0.3rem;
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .mx__stat-bar {
    display: block;
    height: 4px;
    border-radius: 999px;
    background: var(--color-border);
    overflow: hidden;
  }

  .mx__stat-bar-fill {
    display: block;
    height: 100%;
    background: var(--color-accent);
  }

  .mx__lineups {
    display: grid;
    gap: var(--space-4);
  }

  .mx__lineup-team {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent-soft);
  }

  .mx__lineup-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mx__player {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: baseline;
    gap: var(--space-2);
    padding-block: 0.3rem;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .mx__player:last-child {
    border-bottom: 0;
  }

  .mx__num {
    color: var(--color-accent-soft);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .mx__player-name {
    overflow-wrap: anywhere;
  }

  .mx__pos {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
  }

  .mx__empty {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .mx--error {
    text-align: center;
  }

  .mx--error p {
    margin-bottom: var(--space-3);
  }

  @media (min-width: 901px) {
    .mx__logo {
      width: 72px;
      height: 72px;
    }

    .mx__team-name {
      font-size: var(--text-md);
    }

    .mx__grid {
      grid-template-columns: 1.15fr 1fr;
      align-items: start;
    }

    .mx__lineups {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
