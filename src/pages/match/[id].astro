---
// Match detail, ESPN-gamecast style: scoreboard hero, summary timeline,
// split stat bars and lineups. Rendered server-side (SEO + first paint) and
// kept alive by polling /api/match every 60s while the match is on.
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  fetchMatchDetail,
  isValidEventId,
  eventsHtml,
  statsHtml,
  halvesHtml,
} from "../../lib/matchDetail";

export const prerender = false;

const id = Astro.params.id ?? "";
const detail = isValidEventId(id)
  ? await fetchMatchDetail(id).catch(() => null)
  : null;

if (!detail) Astro.response.status = 404;

function fmtDate(iso: string): string {
  if (!iso) return "";
  return new Date(iso).toLocaleString("es-AR", {
    weekday: "short",
    day: "2-digit",
    month: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
  });
}

const title = detail ? `${detail.home.name} vs ${detail.away.name}` : "Partido no encontrado";

const description = !detail
  ? "El detalle del partido no está disponible."
  : detail.status.state === "pre"
    ? `${detail.league} · ${fmtDate(detail.dateUtc)}. ${detail.home.name} vs ${detail.away.name}.`
    : `${detail.league} · ${detail.home.name} ${detail.home.score}-${detail.away.score} ${detail.away.name}. ${detail.status.label}.`;

// Lineup teams arrive as display names from the roster feed: match them to the
// scoreboard sides so each lineup column can show the team crest.
const logoForTeam = (teamName: string): string => {
  if (!detail) return "";
  const key = (teamName || "").trim().toLowerCase();
  if (!key) return "";
  const matches = (side: { name: string; abbreviation: string }) =>
    (side.name || "").trim().toLowerCase() === key ||
    (side.abbreviation || "").trim().toLowerCase() === key;
  if (matches(detail.home)) return detail.home.logo;
  if (matches(detail.away)) return detail.away.logo;
  return "";
};
---

<BaseLayout title={title} description={description}>
  {
    detail ? (
      <article class="mx" data-id={detail.id} data-state={detail.status.state}>
        <header class="mx__head card">
          <div class="mx__topline">
            <span class="mx__league">{detail.league}</span>
            {detail.season && (
              <>
                <span class="mx__tolsep" aria-hidden="true">·</span>
                <span class="mx__season">{detail.season}</span>
              </>
            )}
            <span class="mx__tolsep" aria-hidden="true">·</span>
            <p class="mx__status">
              {detail.status.live && (
                <span class="mx__dot" data-dot aria-hidden="true" />
              )}
              <span data-status>{detail.status.label}</span>
            </p>
          </div>

          <h1 class="mx__scoreline">
            <span class="mx__team mx__team--home">
              {detail.home.logo ? (
                <img
                  class="mx__logo"
                  src={detail.home.logo}
                  alt=""
                  width="64"
                  height="64"
                />
              ) : (
                <span class="mx__logo mx__logo--empty" aria-hidden="true" />
              )}
              <span class="mx__team-name">{detail.home.name}</span>
              {detail.home.record && <span class="mx__record">{detail.home.record}</span>}
            </span>

            {detail.status.state === "pre" ? (
              <span class="mx__vs">vs</span>
            ) : (
              <span class="mx__score">
                <span data-score="home">{detail.home.score}</span>
                <span class="mx__sep" aria-hidden="true">–</span>
                <span data-score="away">{detail.away.score}</span>
              </span>
            )}

            <span class="mx__team mx__team--away">
              {detail.away.logo ? (
                <img
                  class="mx__logo"
                  src={detail.away.logo}
                  alt=""
                  width="64"
                  height="64"
                />
              ) : (
                <span class="mx__logo mx__logo--empty" aria-hidden="true" />
              )}
              <span class="mx__team-name">{detail.away.name}</span>
              {detail.away.record && <span class="mx__record">{detail.away.record}</span>}
            </span>
          </h1>

          <div class="mx__halves" data-halves set:html={halvesHtml(detail)} />

          <p class="mx__meta">
            {detail.dateUtc && <span>{fmtDate(detail.dateUtc)}</span>}
            {detail.venue && <span>{detail.venue}</span>}
          </p>
        </header>

        {detail.status.state !== "pre" && (
          <div class="mx__grid">
            <section class="card mx__section" aria-labelledby="mx-events-title">
              <h2 class="mx__section-title" id="mx-events-title">Resumen</h2>
              <div data-events set:html={eventsHtml(detail)} />
            </section>
            <section class="card mx__section" aria-labelledby="mx-stats-title">
              <h2 class="mx__section-title" id="mx-stats-title">Estadísticas</h2>
              <div data-stats set:html={statsHtml(detail)} />
            </section>
          </div>
        )}

        {detail.lineups.length > 0 && (
          <section class="card mx__section" aria-labelledby="mx-lineups-title">
            <h2 class="mx__section-title" id="mx-lineups-title">Alineaciones</h2>
            <div class="mx__lineups">
              {detail.lineups.map((lineup) => {
                const logo = logoForTeam(lineup.team);
                return (
                  <div class="mx__lineup">
                    <div class="mx__lineup-head">
                      {logo && (
                        <img
                          class="mx__lineup-logo"
                          src={logo}
                          alt=""
                          width="26"
                          height="26"
                        />
                      )}
                      <p class="mx__lineup-team">{lineup.team}</p>
                    </div>
                    <ul class="mx__lineup-list">
                      {lineup.players.map((player) => (
                        <li class="mx__player">
                          <span class="mx__num">{player.number}</span>
                          <span class="mx__player-name">{player.name}</span>
                          <span class="mx__pos">{player.position}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                );
              })}
            </div>
          </section>
        )}

      </article>
    ) : (
      <section class="mx mx--error">
        <div class="card">
          <h1>Partido no encontrado</h1>
          <p class="mx__empty">
            No encontramos ese partido: puede que haya finalizado o que el enlace esté
            mal.
          </p>
          <p>
            <a class="btn btn--soft" href="/">
              Volver al inicio
            </a>
          </p>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>(".mx[data-id]");
  if (root) {
    const id = root.dataset.id!;
    const initial = root.dataset.state!;

    const statusEl = root.querySelector<HTMLElement>("[data-status]");
    const dotEl = root.querySelector<HTMLElement>("[data-dot]");
    const homeScoreEl = root.querySelector<HTMLElement>('[data-score="home"]');
    const awayScoreEl = root.querySelector<HTMLElement>('[data-score="away"]');
    const eventsEl = root.querySelector<HTMLElement>("[data-events]");
    const statsEl = root.querySelector<HTMLElement>("[data-stats]");
    const halvesEl = root.querySelector<HTMLElement>("[data-halves]");

    // Scheduled pages poll too, so a pre-game page flips itself to the live
    // board when the whistle blows; finished matches stop the timer.
    if (initial !== "post") {
      let lastEvents = "";
      let lastStats = "";
      let lastHalves = "";

      const timer = window.setInterval(async () => {
        try {
          const res = await fetch(`/api/match?id=${encodeURIComponent(id)}`, {
            headers: { accept: "application/json" },
          });
          if (!res.ok) return;
          const payload = await res.json();
          const detail = payload?.detail;
          const html = payload?.html;
          if (!detail?.status) return;

          if (initial === "pre" && detail.status.state !== "pre") {
            // The layout changes with the whistle (vs becomes numbers and
            // the sections appear): a fresh page is the honest swap.
            window.clearInterval(timer);
            location.reload();
            return;
          }

          if (statusEl) statusEl.textContent = detail.status.label;
          if (dotEl) dotEl.hidden = !detail.status.live;
          if (homeScoreEl) homeScoreEl.textContent = detail.home.score;
          if (awayScoreEl) awayScoreEl.textContent = detail.away.score;

          if (eventsEl && html.events !== lastEvents) {
            eventsEl.innerHTML = html.events;
            lastEvents = html.events;
          }
          if (statsEl && html.stats !== lastStats) {
            statsEl.innerHTML = html.stats;
            lastStats = html.stats;
          }
          if (halvesEl && html.halves !== lastHalves) {
            halvesEl.innerHTML = html.halves;
            lastHalves = html.halves;
          }

          if (detail.status.state === "post") window.clearInterval(timer);
        } catch {
          // The poll is best-effort: a failed minute is simply retried.
        }
      }, 60_000);
    }
  }
</script>

<!--
  Global: the timeline/stats/halves markup is injected with `set:html` and
  swapped by the poll's `innerHTML`, so it never receives Astro's scope
  attribute. Same reason LiveTicker and NewsList use `is:global` here.
-->
<style is:global>
  .mx {
    display: grid;
    gap: var(--space-3);
  }

  /* ============================================
     Scoreboard hero
     ============================================ */

  .mx .mx__head {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-3);
    text-align: center;
    border-color: var(--color-border-strong);
    background:
      radial-gradient(120% 160% at 50% -30%, rgb(182 240 74 / 12%), transparent 62%),
      linear-gradient(180deg, var(--color-surface-raised) 0%, var(--color-surface) 100%);
  }

  .mx__topline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.3rem 0.55rem;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mx__league {
    color: var(--color-accent-soft);
  }

  .mx__tolsep {
    color: var(--color-border-strong);
  }

  .mx__status {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-text-soft);
    font-weight: 800;
  }

  .mx__dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-danger);
    box-shadow: 0 0 0 3px rgb(226 89 106 / 20%);
    animation: mx-pulse 1.4s ease-in-out infinite;
  }

  @keyframes mx-pulse {
    50% {
      opacity: 0.35;
    }
  }

  /* The matchup itself is the h1: teams and score in one row. */
  .mx__scoreline {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-size: inherit;
    font-weight: 400;
    letter-spacing: normal;
  }

  .mx__team {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .mx__logo {
    width: clamp(52px, 16vw, 64px);
    height: clamp(52px, 16vw, 64px);
    max-width: 100%;
    object-fit: contain;
    filter: drop-shadow(0 6px 14px rgb(0 0 0 / 35%));
  }

  .mx__logo--empty {
    border: 1px dashed var(--color-border-strong);
    border-radius: 50%;
  }

  .mx__team-name {
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .mx__record {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: 1.2;
  }

  .mx__score {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: clamp(2.4rem, 1.6rem + 3.4vw, 3.6rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .mx__sep {
    color: var(--color-text-muted);
    font-size: 0.55em;
    font-weight: 500;
  }

  .mx__vs {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .mx__halves {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
  }

  .mx__half {
    padding: 0.18rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-soft);
    color: var(--color-text-soft);
    font-size: var(--text-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .mx__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .mx__meta span + span::before {
    content: "·";
    margin-inline: 0.55rem;
    color: var(--color-border-strong);
  }

  /* ============================================
     Section cards (shared heading language)
     ============================================ */

  .mx__grid {
    display: grid;
    gap: var(--space-3);
  }

  .mx .mx__section {
    display: grid;
    align-content: start;
    padding: var(--space-3);
    background: linear-gradient(180deg, var(--color-surface-raised) 0%, var(--color-surface) 100%);
  }

  .mx__section-title {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-soft);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mx__section-title::before {
    content: "";
    flex: none;
    width: 4px;
    height: 1.05em;
    border-radius: 999px;
    background: var(--color-accent);
  }

  /* ============================================
     Resumen — event timeline (home left / away mirrored)
     ============================================ */

  .mx__events {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mx__event {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    grid-template-areas:
      "clock icon player"
      "clock icon sub";
    align-items: center;
    column-gap: 0.55rem;
    row-gap: 0.1rem;
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .mx__event:last-child {
    border-bottom: 0;
  }

  .mx__event[data-side="away"] {
    grid-template-columns: minmax(0, 1fr) auto auto;
    grid-template-areas:
      "player icon clock"
      "sub icon clock";
    justify-items: end;
    text-align: right;
  }

  .mx__event-clock {
    grid-area: clock;
    align-self: center;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-soft);
    color: var(--color-text-soft);
    font-size: var(--text-xs);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .mx__event-icon {
    grid-area: icon;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.7rem;
    height: 1.7rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface-soft);
    font-size: 0.95rem;
    line-height: 1;
  }

  .mx__event-player {
    grid-area: player;
    min-width: 0;
    color: var(--color-text-soft);
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .mx__event-sub {
    grid-area: sub;
    min-width: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    overflow-wrap: anywhere;
  }

  .mx__event[data-kind="goal"] .mx__event-player {
    color: var(--color-text);
  }

  .mx__event[data-kind="goal"] .mx__event-icon {
    border-color: rgb(182 240 74 / 55%);
    background: rgb(182 240 74 / 14%);
  }

  .mx__event[data-kind="yellow"] .mx__event-icon {
    border-color: rgb(240 201 74 / 55%);
    background: rgb(240 201 74 / 14%);
  }

  .mx__event[data-kind="red"] .mx__event-icon {
    border-color: rgb(226 89 106 / 55%);
    background: rgb(226 89 106 / 16%);
  }

  /* ============================================
     Estadísticas — split bars meeting in the middle
     ============================================ */

  .mx__stats {
    display: grid;
    gap: 0;
  }

  .mx__stat-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
    margin-bottom: 0.35rem;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mx__stat-head-home {
    text-align: left;
    color: var(--color-accent-soft);
  }

  .mx__stat-head-away {
    text-align: right;
  }

  .mx__stat {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem;
    align-items: center;
    gap: var(--space-2);
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .mx__stat:last-child {
    border-bottom: 0;
  }

  .mx__stat-value {
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .mx__stat-value--home {
    text-align: left;
    color: var(--color-accent-soft);
  }

  .mx__stat-value--away {
    text-align: right;
    color: var(--color-text);
  }

  .mx__stat-info {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .mx__stat-label {
    color: var(--color-text-soft);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .mx__stat-bar {
    display: flex;
    height: 8px;
    border-radius: 999px;
    background: rgb(236 246 239 / 10%);
    overflow: hidden;
  }

  .mx__stat-bar-home,
  .mx__stat-bar-away {
    display: block;
    flex: 0 0 auto;
    height: 100%;
  }

  .mx__stat-bar-home {
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-soft));
  }

  .mx__stat-bar-away {
    background: rgb(236 246 239 / 38%);
  }

  /* ============================================
     Alineaciones
     ============================================ */

  .mx__lineups {
    display: grid;
    gap: var(--space-4);
  }

  .mx__lineup {
    min-width: 0;
  }

  .mx__lineup-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border-strong);
  }

  .mx__lineup-logo {
    flex: none;
    width: 26px;
    height: 26px;
    object-fit: contain;
  }

  .mx__lineup-team {
    margin: 0;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  .mx__lineup-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mx__player {
    display: grid;
    grid-template-columns: 2.1rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2);
    padding-block: 0.4rem;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .mx__player:last-child {
    border-bottom: 0;
  }

  .mx__num {
    display: inline-flex;
    justify-self: start;
    align-items: center;
    justify-content: center;
    min-width: 1.8rem;
    padding: 0.05rem 0.3rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface-soft);
    color: var(--color-accent-soft);
    font-size: var(--text-xs);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .mx__player-name {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .mx__pos {
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .mx__empty {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .mx--error {
    text-align: center;
  }

  .mx--error p {
    margin-bottom: var(--space-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .mx__dot {
      animation: none;
    }
  }

  /* ============================================
     Desktop (min-width: 901px) — columns and air
     ============================================ */

  @media (min-width: 901px) {
    .mx {
      gap: var(--space-4);
    }

    .mx .mx__head {
      gap: var(--space-4);
      padding: var(--space-5) var(--space-4);
    }

    .mx__scoreline {
      gap: var(--space-2) var(--space-3);
    }

    .mx__logo {
      width: 88px;
      height: 88px;
    }

    .mx__team-name {
      font-size: var(--text-md);
    }

    .mx__grid {
      grid-template-columns: 1.15fr 1fr;
      align-items: start;
      gap: var(--space-4);
    }

    .mx .mx__section {
      padding: var(--space-4);
    }

    .mx__stat {
      grid-template-columns: 3.5rem minmax(0, 1fr) 3.5rem;
    }

    .mx__lineups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }
</style>
