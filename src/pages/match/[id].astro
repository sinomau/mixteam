---
// Match detail, ESPN-gamecast style: scoreboard hero with recent form, summary
// timeline, split stat bars (basic + advanced), match leaders, live commentary
// and lineups. Rendered server-side (SEO + first paint) and kept alive by
// polling /api/match every 60s while the match is on.
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  fetchMatchDetail,
  isValidEventId,
  eventsHtml,
  statsHtml,
  statsAdvancedHtml,
  leadersHtml,
  commentaryHtml,
  halvesHtml,
} from "../../lib/matchDetail";

export const prerender = false;

const id = Astro.params.id ?? "";
const detail = isValidEventId(id)
  ? await fetchMatchDetail(id).catch(() => null)
  : null;

if (!detail) Astro.response.status = 404;

function fmtDate(iso: string): string {
  if (!iso) return "";
  return new Date(iso).toLocaleString("es-AR", {
    weekday: "short",
    day: "2-digit",
    month: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
  });
}

const title = detail ? `${detail.home.name} vs ${detail.away.name}` : "Partido no encontrado";

const description = !detail
  ? "El detalle del partido no está disponible."
  : detail.status.state === "pre"
    ? `${detail.league} · ${fmtDate(detail.dateUtc)}. ${detail.home.name} vs ${detail.away.name}.`
    : `${detail.league} · ${detail.home.name} ${detail.home.score}-${detail.away.score} ${detail.away.name}. ${detail.status.label}.`;

// Lineup teams arrive as display names from the roster feed: match them to the
// scoreboard sides so each lineup column can show the team crest.
const logoForTeam = (teamName: string): string => {
  if (!detail) return "";
  const key = (teamName || "").trim().toLowerCase();
  if (!key) return "";
  const matches = (side: { name: string; abbreviation: string }) =>
    (side.name || "").trim().toLowerCase() === key ||
    (side.abbreviation || "").trim().toLowerCase() === key;
  if (matches(detail.home)) return detail.home.logo;
  if (matches(detail.away)) return detail.away.logo;
  return "";
};

// Recent form arrives as a run of G/E/P (won/drawn/lost), most recent first.
// It cannot change while the match is on, so the chips are server-rendered and
// the poll never touches them.
const formResults = (raw: string | undefined): string[] =>
  (raw ?? "").toUpperCase().replace(/[^GEP]/g, "").split("");

const formLabels: Record<string, string> = {
  G: "Ganó",
  E: "Empató",
  P: "Perdió",
};

const formHome = detail ? formResults(detail.form?.home) : [];
const formAway = detail ? formResults(detail.form?.away) : [];
---

<BaseLayout title={title} description={description}>
  {
    detail ? (
      <article class="mx" data-id={detail.id} data-state={detail.status.state}>
        <header class="mx__head card">
          <div class="mx__topline">
            <span class="mx__league">{detail.league}</span>
            {detail.season && (
              <>
                <span class="mx__tolsep" aria-hidden="true">·</span>
                <span class="mx__season">{detail.season}</span>
              </>
            )}
            <span class="mx__tolsep" aria-hidden="true">·</span>
            <p class="mx__status">
              {detail.status.live && (
                <span class="mx__dot" data-dot aria-hidden="true" />
              )}
              <span data-status>{detail.status.label}</span>
            </p>
          </div>

          <h1 class="mx__scoreline">
            <span class="mx__team mx__team--home">
              {detail.home.logo ? (
                <img
                  class="mx__logo"
                  src={detail.home.logo}
                  alt=""
                  width="64"
                  height="64"
                />
              ) : (
                <span class="mx__logo mx__logo--empty" aria-hidden="true" />
              )}
              <span class="mx__team-name">{detail.home.name}</span>
              {detail.home.record && <span class="mx__record">{detail.home.record}</span>}
              {formHome.length > 0 && (
                <span
                  class="mx__form"
                  data-side="home"
                  role="group"
                  aria-label={`Últimos 5 de ${detail.home.name}`}
                >
                  {formHome.map((result) => (
                    <span
                      class="mx__form-chip"
                      data-result={result}
                      title={formLabels[result]}
                    >
                      {result}
                    </span>
                  ))}
                </span>
              )}
            </span>

            {detail.status.state === "pre" ? (
              <span class="mx__vs">vs</span>
            ) : (
              <span class="mx__score">
                <span data-score="home">{detail.home.score}</span>
                <span class="mx__sep" aria-hidden="true">–</span>
                <span data-score="away">{detail.away.score}</span>
              </span>
            )}

            <span class="mx__team mx__team--away">
              {detail.away.logo ? (
                <img
                  class="mx__logo"
                  src={detail.away.logo}
                  alt=""
                  width="64"
                  height="64"
                />
              ) : (
                <span class="mx__logo mx__logo--empty" aria-hidden="true" />
              )}
              <span class="mx__team-name">{detail.away.name}</span>
              {detail.away.record && <span class="mx__record">{detail.away.record}</span>}
              {formAway.length > 0 && (
                <span
                  class="mx__form"
                  data-side="away"
                  role="group"
                  aria-label={`Últimos 5 de ${detail.away.name}`}
                >
                  {formAway.map((result) => (
                    <span
                      class="mx__form-chip"
                      data-result={result}
                      title={formLabels[result]}
                    >
                      {result}
                    </span>
                  ))}
                </span>
              )}
            </span>
          </h1>

          {(formHome.length > 0 || formAway.length > 0) && (
            <p class="mx__form-note">Forma reciente · últimos 5</p>
          )}

          <div class="mx__halves" data-halves set:html={halvesHtml(detail)} />

          <p class="mx__meta">
            {detail.dateUtc && <span>{fmtDate(detail.dateUtc)}</span>}
            {detail.venue && <span>{detail.venue}</span>}
          </p>
        </header>

        {detail.status.state !== "pre" && (
          <div class="mx__grid">
            <section class="card mx__section" aria-labelledby="mx-events-title">
              <h2 class="mx__section-title" id="mx-events-title">Resumen</h2>
              <div data-events set:html={eventsHtml(detail)} />
            </section>
            <section class="card mx__section" aria-labelledby="mx-stats-title">
              <h2 class="mx__section-title" id="mx-stats-title">Estadísticas</h2>
              <div data-stats set:html={statsHtml(detail)} />
            </section>
          </div>
        )}

        {detail.status.state !== "pre" && (
          <>
            <div class="mx__grid mx__grid--extended">
              <section
                class="card mx__section mx__section--secondary"
                aria-labelledby="mx-advanced-title"
              >
                <details class="mx__details">
                  <summary class="mx__details-summary">
                    <h2 class="mx__section-title" id="mx-advanced-title">
                      <span>Estadísticas avanzadas</span>
                      <span class="mx__details-chevron" aria-hidden="true">▾</span>
                    </h2>
                  </summary>
                  <div data-stats-advanced set:html={statsAdvancedHtml(detail)} />
                </details>
              </section>

              {/* Hidden by CSS while ESPN has no leaders to list. */}
              <section
                class="card mx__section mx__section--auto-hide"
                aria-labelledby="mx-leaders-title"
              >
                <h2 class="mx__section-title" id="mx-leaders-title">
                  Figuras del partido
                </h2>
                <div data-leaders set:html={leadersHtml(detail)} />
              </section>
            </div>

            <section class="card mx__section" aria-labelledby="mx-commentary-title">
              <h2 class="mx__section-title" id="mx-commentary-title">Comentarios</h2>
              <div data-commentary set:html={commentaryHtml(detail)} />
            </section>
          </>
        )}

        {detail.lineups.length > 0 && (
          <section class="card mx__section" aria-labelledby="mx-lineups-title">
            <h2 class="mx__section-title" id="mx-lineups-title">Alineaciones</h2>
            <div class="mx__lineups">
              {detail.lineups.map((lineup) => {
                const logo = logoForTeam(lineup.team);
                return (
                  <div class="mx__lineup">
                    <div class="mx__lineup-head">
                      {logo && (
                        <img
                          class="mx__lineup-logo"
                          src={logo}
                          alt=""
                          width="26"
                          height="26"
                        />
                      )}
                      <p class="mx__lineup-team">{lineup.team}</p>
                    </div>
                    <ul class="mx__lineup-list">
                      {lineup.players.map((player) => (
                        <li class="mx__player">
                          <span class="mx__num">{player.number}</span>
                          <span class="mx__player-name">{player.name}</span>
                          <span class="mx__pos">{player.position}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                );
              })}
            </div>
          </section>
        )}

      </article>
    ) : (
      <section class="mx mx--error">
        <div class="card">
          <h1>Partido no encontrado</h1>
          <p class="mx__empty">
            No encontramos ese partido: puede que haya finalizado o que el enlace esté
            mal.
          </p>
          <p>
            <a class="btn btn--soft" href="/">
              Volver al inicio
            </a>
          </p>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>(".mx[data-id]");
  if (root) {
    const id = root.dataset.id!;
    const initial = root.dataset.state!;

    const statusEl = root.querySelector<HTMLElement>("[data-status]");
    const dotEl = root.querySelector<HTMLElement>("[data-dot]");
    const homeScoreEl = root.querySelector<HTMLElement>('[data-score="home"]');
    const awayScoreEl = root.querySelector<HTMLElement>('[data-score="away"]');
    const eventsEl = root.querySelector<HTMLElement>("[data-events]");
    const statsEl = root.querySelector<HTMLElement>("[data-stats]");
    const halvesEl = root.querySelector<HTMLElement>("[data-halves]");
    const advancedStatsEl = root.querySelector<HTMLElement>("[data-stats-advanced]");
    const leadersEl = root.querySelector<HTMLElement>("[data-leaders]");
    const commentaryEl = root.querySelector<HTMLElement>("[data-commentary]");

    // Advanced stats read as the second layer: collapsed on phones, open on
    // desktop where the paired card has room. CSS cannot open a `details`, so
    // the breakpoint drives the attribute and only acts on real crossings.
    const advancedDetails = root.querySelector<HTMLDetailsElement>(".mx__details");
    if (advancedDetails) {
      const desktop = window.matchMedia("(min-width: 901px)");
      const syncDetails = () => {
        advancedDetails.open = desktop.matches;
      };
      syncDetails();
      desktop.addEventListener("change", syncDetails);
    }

    // The feed is oldest-first and grows at the bottom: land on the newest.
    const feedEl = commentaryEl?.querySelector<HTMLElement>(".mx__commentary");
    if (feedEl) feedEl.scrollTop = feedEl.scrollHeight;

    // Scheduled pages poll too, so a pre-game page flips itself to the live
    // board when the whistle blows; finished matches stop the timer.
    if (initial !== "post") {
      let lastEvents = "";
      let lastStats = "";
      let lastHalves = "";
      // Seed the new sections from the server markup: a minute then rewrites
      // only what actually changed, so the feed keeps its scroll position.
      let lastStatsAdvanced = advancedStatsEl?.innerHTML ?? "";
      let lastLeaders = leadersEl?.innerHTML ?? "";
      let lastCommentary = commentaryEl?.innerHTML ?? "";

      const timer = window.setInterval(async () => {
        try {
          const res = await fetch(`/api/match?id=${encodeURIComponent(id)}`, {
            headers: { accept: "application/json" },
          });
          if (!res.ok) return;
          const payload = await res.json();
          const detail = payload?.detail;
          const html = payload?.html;
          if (!detail?.status) return;

          if (initial === "pre" && detail.status.state !== "pre") {
            // The layout changes with the whistle (vs becomes numbers and
            // the sections appear): a fresh page is the honest swap.
            window.clearInterval(timer);
            location.reload();
            return;
          }

          if (statusEl) statusEl.textContent = detail.status.label;
          if (dotEl) dotEl.hidden = !detail.status.live;
          if (homeScoreEl) homeScoreEl.textContent = detail.home.score;
          if (awayScoreEl) awayScoreEl.textContent = detail.away.score;

          if (eventsEl && html.events !== lastEvents) {
            eventsEl.innerHTML = html.events;
            lastEvents = html.events;
          }
          if (statsEl && html.stats !== lastStats) {
            statsEl.innerHTML = html.stats;
            lastStats = html.stats;
          }
          if (halvesEl && html.halves !== lastHalves) {
            halvesEl.innerHTML = html.halves;
            lastHalves = html.halves;
          }

          const nextStatsAdvanced = html.statsAdvanced ?? "";
          if (advancedStatsEl && nextStatsAdvanced !== lastStatsAdvanced) {
            advancedStatsEl.innerHTML = nextStatsAdvanced;
            lastStatsAdvanced = nextStatsAdvanced;
          }

          const nextLeaders = html.leaders ?? "";
          if (leadersEl && nextLeaders !== lastLeaders) {
            leadersEl.innerHTML = nextLeaders;
            lastLeaders = nextLeaders;
          }

          const nextCommentary = html.commentary ?? "";
          if (commentaryEl && nextCommentary !== lastCommentary) {
            // Stay pinned to the newest comment unless the reader scrolled up
            // to read history.
            const list = commentaryEl.querySelector<HTMLElement>(".mx__commentary");
            const pinned =
              !list || list.scrollHeight - list.scrollTop - list.clientHeight < 48;
            commentaryEl.innerHTML = nextCommentary;
            lastCommentary = nextCommentary;
            const next = commentaryEl.querySelector<HTMLElement>(".mx__commentary");
            if (next && pinned) next.scrollTop = next.scrollHeight;
          }

          if (detail.status.state === "post") window.clearInterval(timer);
        } catch {
          // The poll is best-effort: a failed minute is simply retried.
        }
      }, 60_000);
    }
  }
</script>

<!--
  Global: the timeline, stats, halves, leaders and commentary markup is
  injected with `set:html` and swapped by the poll's `innerHTML`, so it never
  receives Astro's scope attribute. Same reason LiveTicker and NewsList use
  `is:global` here.
-->
<style is:global>
  .mx {
    display: grid;
    gap: var(--space-3);
  }

  /* ============================================
     Scoreboard hero
     ============================================ */

  .mx .mx__head {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-3);
    text-align: center;
    border-color: var(--color-border-strong);
    background:
      radial-gradient(120% 160% at 50% -30%, rgb(182 240 74 / 12%), transparent 62%),
      linear-gradient(180deg, var(--color-surface-raised) 0%, var(--color-surface) 100%);
  }

  .mx__topline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.3rem 0.55rem;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mx__league {
    color: var(--color-accent-soft);
  }

  .mx__tolsep {
    color: var(--color-border-strong);
  }

  .mx__status {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-text-soft);
    font-weight: 800;
  }

  .mx__dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-danger);
    box-shadow: 0 0 0 3px rgb(226 89 106 / 20%);
    animation: mx-pulse 1.4s ease-in-out infinite;
  }

  @keyframes mx-pulse {
    50% {
      opacity: 0.35;
    }
  }

  /* The matchup itself is the h1: teams and score in one row. */
  .mx__scoreline {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-size: inherit;
    font-weight: 400;
    letter-spacing: normal;
  }

  .mx__team {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .mx__logo {
    width: clamp(52px, 16vw, 64px);
    height: clamp(52px, 16vw, 64px);
    max-width: 100%;
    object-fit: contain;
    filter: drop-shadow(0 6px 14px rgb(0 0 0 / 35%));
  }

  .mx__logo--empty {
    border: 1px dashed var(--color-border-strong);
    border-radius: 50%;
  }

  .mx__team-name {
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .mx__record {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: 1.2;
  }

  .mx__score {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: clamp(2.4rem, 1.6rem + 3.4vw, 3.6rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .mx__sep {
    color: var(--color-text-muted);
    font-size: 0.55em;
    font-weight: 500;
  }

  .mx__vs {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .mx__halves {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
  }

  .mx__half {
    padding: 0.18rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-soft);
    color: var(--color-text-soft);
    font-size: var(--text-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .mx__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .mx__meta span + span::before {
    content: "·";
    margin-inline: 0.55rem;
    color: var(--color-border-strong);
  }

  /* Recent form: five small chips under each team, most recent first. */
  .mx__form {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    max-width: 100%;
  }

  .mx__form-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15rem;
    height: 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface-soft);
    color: var(--color-text-muted);
    font-size: 0.65rem;
    font-weight: 800;
    line-height: 1;
  }

  .mx__form-chip[data-result="G"] {
    border-color: rgb(182 240 74 / 55%);
    background: rgb(182 240 74 / 18%);
    color: var(--color-accent-soft);
  }

  .mx__form-chip[data-result="P"] {
    border-color: rgb(226 89 106 / 38%);
    background: rgb(226 89 106 / 12%);
    color: var(--color-text-muted);
  }

  /* One legend for both strips: the letters alone are too cryptic. */
  .mx__form-note {
    margin: calc(-1 * var(--space-2)) 0 0;
    color: var(--color-text-muted);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  /* ============================================
     Section cards (shared heading language)
     ============================================ */

  .mx__grid {
    display: grid;
    gap: var(--space-3);
  }

  .mx .mx__section {
    display: grid;
    align-content: start;
    padding: var(--space-3);
    background: linear-gradient(180deg, var(--color-surface-raised) 0%, var(--color-surface) 100%);
  }

  .mx__section-title {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-soft);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mx__section-title::before {
    content: "";
    flex: none;
    width: 4px;
    height: 1.05em;
    border-radius: 999px;
    background: var(--color-accent);
  }

  /* Advanced stats sit below the basics: a flatter, quieter card whose body
     folds away on phones. */
  .mx .mx__section--secondary {
    border-color: var(--color-border);
    background: var(--color-surface-soft);
  }

  .mx__details {
    display: block;
  }

  .mx__details-summary {
    display: block;
    cursor: pointer;
    list-style: none;
  }

  .mx__details-summary::-webkit-details-marker {
    display: none;
  }

  .mx__details-summary::marker {
    content: "";
  }

  /* The heading is the toggle: collapse, then let the body start right under
     it without the usual gap. */
  .mx__details-summary .mx__section-title {
    margin-bottom: 0;
  }

  .mx__details[open] .mx__details-summary .mx__section-title {
    margin-bottom: var(--space-3);
  }

  .mx__details-chevron {
    flex: none;
    margin-left: auto;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .mx__details[open] .mx__details-chevron {
    transform: rotate(180deg);
  }

  /* A card whose builder returned nothing: no heading left behind. */
  .mx .mx__section--auto-hide:has(> [data-leaders]:empty) {
    display: none;
  }

  /* ============================================
     Resumen — event timeline (home left / away mirrored)
     ============================================ */

  .mx__events {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mx__event {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    grid-template-areas:
      "clock icon player"
      "clock icon sub";
    align-items: center;
    column-gap: 0.55rem;
    row-gap: 0.1rem;
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .mx__event:last-child {
    border-bottom: 0;
  }

  .mx__event[data-side="away"] {
    grid-template-columns: minmax(0, 1fr) auto auto;
    grid-template-areas:
      "player icon clock"
      "sub icon clock";
    justify-items: end;
    text-align: right;
  }

  .mx__event-clock {
    grid-area: clock;
    align-self: center;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-soft);
    color: var(--color-text-soft);
    font-size: var(--text-xs);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .mx__event-icon {
    grid-area: icon;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.7rem;
    height: 1.7rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface-soft);
    font-size: 0.95rem;
    line-height: 1;
  }

  .mx__event-player {
    grid-area: player;
    min-width: 0;
    color: var(--color-text-soft);
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .mx__event-sub {
    grid-area: sub;
    min-width: 0;
    color: var(--color-text-muted);
